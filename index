// リトライ・状態リセット
function resetPlayState() {
  isGameOver = false;
  isGameClear = false;
  gameOverAlpha = 0;
  gameClearAlpha = 0;

  // 1. 火の初期配置復元
  fires = initialFires.map(f => new Fire(f.x, f.y, f.maxRadius || 13.0));

  // 1.5. 壁の初期配置復元（燃えて朽ちた木壁も含めてマップを元に戻す）
  walls = initialWalls.map(w => ({ ...w }));

  // 2. プレイヤー位置リセット
  player.x = spawnPoint.x;
  player.y = spawnPoint.y;
  player.vx = 0; player.vy = 0;
  carriedBox = null;
  carriedExtinguisher = null;
  carriedRope = null;

  // 3. 敵（バンディット）のリセット
  bandits.forEach(b => b.reset());

  // 4. 消防士のリセット
  firefighters.forEach(ff => ff.reset());

  // 消火泡・縄破片パーティクルのクリア
  foamParticles = [];
  ropeCutParticles = [];
  smokeParticles = [];

  if (isEditMode) updateStats();
}

// ヘルプおよびエディタパネル非表示切り替え関数
function toggleHelp() {
  showHelp = !showHelp;
  const hint = document.getElementById('controls-hint');
  if (hint) hint.style.display = showHelp ? 'block' : 'none';

  const panel = document.getElementById('editor-panel');
  if (panel && isEditMode) {
    panel.style.display = showHelp ? 'block' : 'none';
  }
}

// 火のみ削除関数
function clearAllFires() {
  fires = [];
  initialFires = [];
  smokeParticles = [];
  if (isEditMode) updateStats();
}

// --- キー入力 ---
window.addEventListener('keydown', ev => {
  const k = ev.key.toLowerCase();
  
  if (ev.key === 'Tab') {
    ev.preventDefault();
    isEditMode = !isEditMode;
    const modeLabel = document.getElementById('mode-label');
    const panel = document.getElementById('editor-panel');
    modeLabel.innerText = isEditMode ? 'EDIT MODE' : 'PLAY MODE';
    modeLabel.className = `badge ${isEditMode ? 'edit-badge' : 'play-badge'}`;
    if (panel) panel.style.display = (isEditMode && showHelp) ? 'block' : 'none';
    setUiLayerEditVisibility(isEditMode);
    
    if (isEditMode) {
      updateStats();
      applyEditorCameraTransform();
    } else {
      // エディタからゲームモード開始時: 配置した火・壁を初期状態として保存しゲーム開始
      initialFires = fires.map(f => ({ x: f.x, y: f.y, maxRadius: f.maxRadius }));
      initialWalls = walls.map(w => ({ ...w }));
      resetPlayState();
      canvas.style.transform = '';
    }
    return;
  }

  if (k === 'h') {
    toggleHelp();
    return;
  }

  if ((isGameOver || isGameClear) && k === 'r') {
    resetPlayState();
    return;
  }

  if (ev.key === ' ' || ev.key === 'Spacebar') {
    keys.space = true;
    ev.preventDefault();

    if (carriedRope && !isGameOver && !isGameClear) {
      let targetBandit = bandits.find(b => !b.isTied && !b.isNeutralized && Math.hypot(player.x - b.x, player.y - b.y) < 22);
      if (targetBandit) {
        targetBandit.isTied = true;
        targetBandit.tiedTimer = 600;
        ropes = ropes.filter(r => r !== carriedRope);
        carriedRope = null;
        if (isEditMode) updateStats();
      }
    }
  }

  if (isEditMode) {
    if (ev.ctrlKey && k === 'z') { ev.preventDefault(); if (ev.shiftKey) doRedo(); else doUndo(); return; }
    if (ev.ctrlKey && k === 'y') { ev.preventDefault(); doRedo(); return; }

    if (k === 'arrowleft') { camKeys.left = true; ev.preventDefault(); }
    if (k === 'arrowright') { camKeys.right = true; ev.preventDefault(); }
    if (k === 'arrowup') { camKeys.up = true; ev.preventDefault(); }
    if (k === 'arrowdown') { camKeys.down = true; ev.preventDefault(); }

    if (k === 's') setTool('spawn');
    if (k === '1') setTool('wall');
    if (k === '2') setTool('door');
    if (k === '3') setTool('desk');
    if (k === '4') setTool('chair');
    if (k === '5') setTool('bed');
    if (k === '6') setTool('shelf');
    if (k === '7') setTool('tv');
    if (k === '8') setTool('phone');
    if (k === '9') setTool('washer');
    if (k === 'c') setTool('clock');
    if (k === '0') setTool('erase');

    if (k === 'r') {
      itemRotateAngle = (itemRotateAngle + Math.PI / 2) % (Math.PI * 2);
    }
    return;
  }

  if (k === 'shift') keys.shift = true;
  if (k in keys) keys[k] = true;
  if (k === 'f') isLightOn = !isLightOn;

  if (k === 'e' && !ev.repeat && !isGameOver && !isGameClear) {
    if (carriedBox) {
      let tiedBandit = bandits.find(b => b.isTied && !b.isNeutralized && Math.hypot(carriedBox.x - b.x, carriedBox.y - b.y) < 18);
      if (tiedBandit) {
        tiedBandit.isNeutralized = true;
        tiedBandit.isTied = true;
        boxes = boxes.filter(b => b !== carriedBox);
        carriedBox = null;
        keys.e = false;
        if (isEditMode) updateStats();
        return;
      }
    }

    if (carriedBox) {
      carriedBox.isCarried = false; carriedBox = null; keys.e = false;
    } else if (carriedExtinguisher) {
      carriedExtinguisher.isCarried = false; carriedExtinguisher = null; keys.e = false;
    } else if (carriedRope) {
      carriedRope.isCarried = false; carriedRope = null; keys.e = false;
    } else {
      let activeDoor = doors.find(d => d.isHeld);
      if (activeDoor) {
        activeDoor.isHeld = false; keys.e = false;
      } else {
        let nearestDoor = null;
        let minDoorDist = 18;
        doors.forEach(d => {
          const knob = d.getKnobPos();
          const dist = Math.hypot(player.x - knob.x, player.y - knob.y);
          if (dist < minDoorDist) { minDoorDist = dist; nearestDoor = d; }
        });

        if (nearestDoor) {
          nearestDoor.startHold(player.x, player.y);
        } else {
          let minDist = 18;
          let nearestBox = null, nearestExt = null, nearestRope = null;

          boxes.forEach(b => {
            const d = Math.hypot(player.x - b.x, player.y - b.y);
            if (d < minDist) { minDist = d; nearestBox = b; }
          });
          extinguishers.forEach(ext => {
            const d = Math.hypot(player.x - ext.x, player.y - ext.y);
            if (d < minDist) { minDist = d; nearestExt = ext; nearestBox = null; }
          });
          ropes.forEach(rp => {
            const d = Math.hypot(player.x - rp.x, player.y - rp.y);
            if (d < minDist) { minDist = d; nearestRope = rp; nearestExt = null; nearestBox = null; }
          });

          if (nearestBox) { carriedBox = nearestBox; carriedBox.isCarried = true; }
          else if (nearestExt) { carriedExtinguisher = nearestExt; carriedExtinguisher.isCarried = true; }
          else if (nearestRope) { carriedRope = nearestRope; carriedRope.isCarried = true; }
          else { keys.e = true; }
        }
      }
    }
  }
});

window.addEventListener('keyup', ev => {
  const k = ev.key.toLowerCase();
  if (ev.key === ' ' || ev.key === 'Spacebar') keys.space = false;
  if (k === 'shift') keys.shift = false;
  if (k in keys) keys[k] = false;
  if (k === 'e' && !carriedBox && !carriedExtinguisher && !carriedRope && !doors.some(d => d.isHeld)) keys.e = false;

  if (k === 'arrowleft') camKeys.left = false;
  if (k === 'arrowright') camKeys.right = false;
  if (k === 'arrowup') camKeys.up = false;
  if (k === 'arrowdown') camKeys.down = false;
});

// --- エディタ: マウスホイールでズーム（カーソル位置を中心に） ---
canvas.addEventListener('wheel', e => {
  if (!isEditMode) return;
  e.preventDefault();

  const rect = canvas.getBoundingClientRect();
  const cursorRatioX = (e.clientX - rect.left) / rect.width;
  const cursorRatioY = (e.clientY - rect.top) / rect.height;
  // 現在のワールド座標（クランプ前）
  const worldX = editorCamera.x + cursorRatioX * (WIDTH / editorCamera.zoom);
  const worldY = editorCamera.y + cursorRatioY * (HEIGHT / editorCamera.zoom);

  const zoomFactor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
  editorCamera.zoom = Math.max(1, Math.min(6, editorCamera.zoom * zoomFactor));

  editorCamera.x = worldX - cursorRatioX * (WIDTH / editorCamera.zoom);
  editorCamera.y = worldY - cursorRatioY * (HEIGHT / editorCamera.zoom);
  clampEditorCamera();
  applyEditorCameraTransform();
}, { passive: false });

window.addEventListener('resize', () => { if (isEditMode) applyEditorCameraTransform(); });

// --- マウス操作 ---
function getMousePos(e) {
  const rect = canvas.getBoundingClientRect();
  let x = (e.clientX - rect.left) / rect.width * WIDTH;
  let y = (e.clientY - rect.top) / rect.height * HEIGHT;

  // キャンバスの外に少しはみ出してもステージ端(0〜WIDTH/HEIGHT)にクランプする。
  // これにより端っこギリギリの壁作成・削除・設置がしやすくなる。
  x = Math.max(0, Math.min(WIDTH, x));
  y = Math.max(0, Math.min(HEIGHT, y));

  if (snapToGrid) {
    x = Math.round(x / 8) * 8;
    y = Math.round(y / 8) * 8;
    x = Math.max(0, Math.min(WIDTH, x));
    y = Math.max(0, Math.min(HEIGHT, y));
  }
  return { x, y };
}

canvas.addEventListener('mousemove', e => {
  currentMousePos = getMousePos(e);
  isMouseInCanvas = true;
});

canvas.addEventListener('mouseleave', () => {
  isMouseInCanvas = false;
  // 壁作成中にカーソルがキャンバス外に出ても始点は保持する。
  // (端っこに壁を引く際、キャンバスの外へ少しはみ出すとリセットされてしまう問題への対処)
});

const furnitureTypes = ['desk', 'chair', 'bed', 'shelf', 'tv', 'phone', 'washer', 'clock', 'fridge', 'sofa', 'sink', 'plant', 'tree', 'lamp'];

canvas.addEventListener('mousedown', e => {
  if (!isEditMode) return;
  const m = getMousePos(e);

  if (currentTool === 'template-capture') {
    templateCaptureStart = m;
    return;
  } else if (currentTool === 'template-stamp') {
    if (activeTemplateName) stampTemplateAt(activeTemplateName, m.x, m.y);
    return;
  }

  // これ以降はマップを変更する操作なので、Undo用のスナップショットを積んでおく
  // (壁だけはドラッグ完了時=mouseup側で積む)
  if (currentTool !== 'wall') pushUndo();

  if (currentTool === 'spawn') {
    spawnPoint = { x: m.x, y: m.y };
  } else if (currentTool === 'wall') {
    wallStartPoint = m;
  } else if (currentTool === 'door') {
    const dType = document.getElementById('sel-door-type').value;
    doors.push(new Door(m.x, m.y, 22, itemRotateAngle, dType));
  } else if (furnitureTypes.includes(currentTool)) {
    furnitures.push(new Furniture(currentTool, m.x, m.y, itemRotateAngle));
  } else if (currentTool === 'box') {
    boxes.push(new WoodBox(m.x, m.y));
  } else if (currentTool === 'extinguisher') {
    extinguishers.push(new Extinguisher(m.x, m.y));
  } else if (currentTool === 'fire') {
    fires.push(new Fire(m.x, m.y));
    initialFires.push({ x: m.x, y: m.y, maxRadius: 13.0 });
  } else if (currentTool === 'rope') {
    ropes.push(new Rope(m.x, m.y));
  } else if (currentTool === 'bandit') {
    bandits.push(new Bandit(m.x, m.y));
  } else if (currentTool === 'firefighter') {
    firefighters.push(new Firefighter(m.x, m.y));
  } else if (currentTool === 'erase') {
    const radius = 12;
    const distToSegment = (px, py, x1, y1, x2, y2) => {
      const dx = x2 - x1, dy = y2 - y1;
      const lenSq = dx * dx + dy * dy;
      let t = lenSq === 0 ? 0 : ((px - x1) * dx + (py - y1) * dy) / lenSq;
      t = Math.max(0, Math.min(1, t));
      const cx = x1 + t * dx, cy = y1 + t * dy;
      return Math.hypot(px - cx, py - cy);
    };
    walls = walls.filter(w => distToSegment(m.x, m.y, w.x1, w.y1, w.x2, w.y2) > radius);
    doors = doors.filter(d => Math.hypot(m.x - d.hx, m.y - d.hy) > radius);
    furnitures = furnitures.filter(f => Math.hypot(m.x - f.x, m.y - f.y) > radius);
    boxes = boxes.filter(b => Math.hypot(m.x - b.x, m.y - b.y) > radius);
    extinguishers = extinguishers.filter(ext => Math.hypot(m.x - ext.x, m.y - ext.y) > radius);
    fires = fires.filter(f => Math.hypot(m.x - f.x, m.y - f.y) > radius);
    initialFires = initialFires.filter(f => Math.hypot(m.x - f.x, m.y - f.y) > radius);
    ropes = ropes.filter(r => Math.hypot(m.x - r.x, m.y - r.y) > radius);
    bandits = bandits.filter(b => Math.hypot(m.x - b.x, m.y - b.y) > radius);
    firefighters = firefighters.filter(ff => Math.hypot(m.x - ff.x, m.y - ff.y) > radius);
  }
  updateStats();
});

// canvasではなくwindowでmouseupを受ける。
// ステージ端に壁を引くとき、マウスがキャンバス範囲を少しはみ出したまま
// ボタンを離すことが多く、canvas限定のmouseupだと壁が確定しなかったため。
window.addEventListener('mouseup', e => {
  if (!isEditMode) return;

  if (currentTool === 'template-capture' && templateCaptureStart) {
    const m = getMousePos(e);
    if (Math.hypot(m.x - templateCaptureStart.x, m.y - templateCaptureStart.y) > 4) {
      captureTemplateFromRect(templateCaptureStart.x, templateCaptureStart.y, m.x, m.y);
    }
    templateCaptureStart = null;
    return;
  }

  if (currentTool !== 'wall' || !wallStartPoint) return;
  const m = getMousePos(e);
  if (Math.hypot(m.x - wallStartPoint.x, m.y - wallStartPoint.y) > 4) {
    pushUndo();
    const type = document.getElementById('sel-wall-type').value;
    walls.push({ x1: wallStartPoint.x, y1: wallStartPoint.y, x2: m.x, y2: m.y, type, hp: type === 'wood' ? 100 : undefined });
    updateStats();
  }
  wallStartPoint = null;
});

function setTool(tool) {
  currentTool = tool;
  document.querySelectorAll('.tool-btn').forEach(b => {
    if (!b.classList.contains('danger-btn')) b.classList.remove('active');
  });
  const btnId = `btn-tool-${tool === 'extinguisher' ? 'ext' : tool}`;
  const el = document.getElementById(btnId);
  if (el) el.classList.add('active');
}

function clearAllObjects() {
  if (confirm('すべてのオブジェクトを削除しますか？')) {
    walls = []; doors = []; furnitures = []; boxes = []; extinguishers = []; fires = []; initialFires = []; ropes = []; bandits = []; firefighters = []; smokeParticles = [];
    updateStats();
  }
}

document.getElementById('chk-snap').onchange = (e) => snapToGrid = e.target.checked;

function buildMapDataObject() {
  return {
    stageSize: `${WIDTH}x${HEIGHT}`,
    isClearMode,
    maxFireLimit,
    mapEnvironment,
    windAngle,
    windStrength,
    spawnPoint,
    walls,
    doors: doors.map(d => ({ hx: d.hx, hy: d.hy, length: d.length, angle: d.baseAngle, type: d.type || 'wood' })),
    furnitures: furnitures.map(f => ({ type: f.type, x: f.x, y: f.y, angle: f.angle })),
    boxes: boxes.map(b => ({ x: b.x, y: b.y })),
    extinguishers: extinguishers.map(e => ({ x: e.x, y: e.y })),
    fires: fires.map(f => ({ x: f.x, y: f.y })),
    ropes: ropes.map(r => ({ x: r.x, y: r.y })),
    bandits: bandits.map(b => ({ x: b.startX, y: b.startY })),
    firefighters: firefighters.map(ff => ({ x: ff.startX, y: ff.startY }))
  };
}

function applyMapDataObject(data) {
  if (data.stageSize) {
    document.getElementById('sel-stage-size').value = data.stageSize;
    changeStageSize(data.stageSize);
  }
  if (data.isClearMode !== undefined) {
    isClearMode = data.isClearMode;
    document.getElementById('sel-game-mode').value = isClearMode ? 'clear' : 'free';
  }
  if (data.maxFireLimit !== undefined) {
    maxFireLimit = data.maxFireLimit;
    document.getElementById('num-fire-limit').value = maxFireLimit;
  }
  if (data.mapEnvironment) {
    mapEnvironment = data.mapEnvironment;
    document.getElementById('sel-environment').value = mapEnvironment;
  }
  if (data.windAngle !== undefined) {
    windAngle = data.windAngle;
    document.getElementById('range-wind-angle').value = Math.round(windAngle * 180 / Math.PI);
  }
  if (data.windStrength !== undefined) {
    windStrength = data.windStrength;
    document.getElementById('num-wind-strength').value = windStrength;
  }
  updateWindDisplay();
  if (data.spawnPoint) spawnPoint = data.spawnPoint;
  if (data.walls) { walls = data.walls; initialWalls = walls.map(w => ({ ...w })); }
  if (data.doors) doors = data.doors.map(d => new Door(d.hx, d.hy, d.length || 22, d.angle, d.type || 'wood'));
  if (data.furnitures) {
    furnitures = data.furnitures.map(f => new Furniture(f.type, f.x, f.y, f.angle || 0));
  }
  if (data.boxes) boxes = data.boxes.map(b => new WoodBox(b.x, b.y));
  if (data.extinguishers) extinguishers = data.extinguishers.map(e => new Extinguisher(e.x, e.y));
  if (data.fires) {
    fires = data.fires.map(f => new Fire(f.x, f.y));
    initialFires = fires.map(f => ({ x: f.x, y: f.y, maxRadius: f.maxRadius }));
  }
  if (data.ropes) ropes = data.ropes.map(r => new Rope(r.x, r.y));
  if (data.bandits) bandits = data.bandits.map(b => new Bandit(b.x, b.y));
  if (data.firefighters) firefighters = data.firefighters.map(ff => new Firefighter(ff.x, ff.y));
  updateStats();
  resetPlayState();
  undoStack = [];
  redoStack = [];
}

