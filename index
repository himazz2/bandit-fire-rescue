// 回転可能な要素のピクセル描画ヘルパー
function drawRotatedPattern(fx, fy, w, h, angle, pixelCallback) {
  const cos = Math.cos(-angle);
  const sin = Math.sin(-angle);
  const halfW = w / 2;
  const halfH = h / 2;
  const diag = Math.ceil(Math.hypot(halfW, halfH));

  const minX = Math.max(0, Math.floor(fx - diag));
  const maxX = Math.min(WIDTH - 1, Math.ceil(fx + diag));
  const minY = Math.max(0, Math.floor(fy - diag));
  const maxY = Math.min(HEIGHT - 1, Math.ceil(fy + diag));

  for (let py = minY; py <= maxY; py++) {
    for (let px = minX; px <= maxX; px++) {
      const dx = px - fx;
      const dy = py - fy;
      const lx = dx * cos - dy * sin;
      const ly = dx * sin + dy * cos;

      if (Math.abs(lx) <= halfW && Math.abs(ly) <= halfH) {
        const pIdx = (py * WIDTH + px) * 4;
        pixelCallback(lx, ly, pIdx, pixels);
      }
    }
  }
}

// 家具のピクセル描画
function renderFurniture(f) {
  const hw = f.w / 2;
  const hh = f.h / 2;

  drawRotatedPattern(f.x, f.y, f.w, f.h, f.angle, (lx, ly, pIdx, pixels) => {
    const isEdge = (Math.abs(lx) >= hw - 0.9 || Math.abs(ly) >= hh - 0.9);

    switch(f.type) {
      case 'desk':
        if (isEdge) {
          pixels[pIdx] = 70; pixels[pIdx+1] = 45; pixels[pIdx+2] = 20;
        } else {
          pixels[pIdx] = 140; pixels[pIdx+1] = 95; pixels[pIdx+2] = 50;
        }
        break;

      case 'chair':
        if (ly < -hh + 2) {
          pixels[pIdx] = 30; pixels[pIdx+1] = 50; pixels[pIdx+2] = 80;
        } else if (isEdge) {
          pixels[pIdx] = 40; pixels[pIdx+1] = 70; pixels[pIdx+2] = 110;
        } else {
          pixels[pIdx] = 80; pixels[pIdx+1] = 120; pixels[pIdx+2] = 180;
        }
        break;

      case 'bed':
        if (isEdge) {
          pixels[pIdx] = 90; pixels[pIdx+1] = 60; pixels[pIdx+2] = 30;
        } else if (ly < -hh + 5) {
          pixels[pIdx] = 230; pixels[pIdx+1] = 230; pixels[pIdx+2] = 240;
        } else if (ly < -hh + 7) {
          pixels[pIdx] = 160; pixels[pIdx+1] = 160; pixels[pIdx+2] = 170;
        } else {
          const stripe = (Math.floor(lx + ly) % 4 === 0);
          pixels[pIdx] = stripe ? 40 : 60;
          pixels[pIdx+1] = stripe ? 100 : 140;
          pixels[pIdx+2] = stripe ? 180 : 220;
        }
        break;

      case 'shelf':
        if (isEdge) {
          pixels[pIdx] = 80; pixels[pIdx+1] = 50; pixels[pIdx+2] = 25;
        } else {
          const colIndex = Math.floor(Math.abs(lx + hw) % 5);
          if (colIndex === 0) { pixels[pIdx] = 180; pixels[pIdx+1] = 40; pixels[pIdx+2] = 40; }
          else if (colIndex === 1) { pixels[pIdx] = 40; pixels[pIdx+1] = 140; pixels[pIdx+2] = 60; }
          else if (colIndex === 2) { pixels[pIdx] = 200; pixels[pIdx+1] = 180; pixels[pIdx+2] = 50; }
          else if (colIndex === 3) { pixels[pIdx] = 50; pixels[pIdx+1] = 90; pixels[pIdx+2] = 180; }
          else { pixels[pIdx] = 130; pixels[pIdx+1] = 70; pixels[pIdx+2] = 160; }
        }
        break;

      case 'tv':
        if (isEdge) {
          pixels[pIdx] = 30; pixels[pIdx+1] = 30; pixels[pIdx+2] = 35;
        } else if (ly >= -hh + 2 && ly <= hh - 2 && lx >= -hw + 2 && lx <= hw - 2) {
          const flicker = (Math.random() < 0.15);
          pixels[pIdx] = flicker ? 200 : 20;
          pixels[pIdx+1] = flicker ? 220 : 120;
          pixels[pIdx+2] = flicker ? 255 : 180;
        } else {
          pixels[pIdx] = 50; pixels[pIdx+1] = 50; pixels[pIdx+2] = 55;
        }
        break;

      case 'phone':
        if (isEdge) {
          pixels[pIdx] = 100; pixels[pIdx+1] = 65; pixels[pIdx+2] = 35;
        } else {
          if (lx < -1) {
            pixels[pIdx] = 220; pixels[pIdx+1] = 220; pixels[pIdx+2] = 230;
          } else {
            const dot = ((Math.floor(lx) + Math.floor(ly)) % 2 === 0);
            pixels[pIdx] = dot ? 50 : 180;
            pixels[pIdx+1] = dot ? 50 : 180;
            pixels[pIdx+2] = dot ? 50 : 190;
          }
        }
        break;

      case 'washer':
        if (isEdge) {
          pixels[pIdx] = 180; pixels[pIdx+1] = 185; pixels[pIdx+2] = 190;
        } else {
          const distFromCenter = Math.hypot(lx, ly + 0.8);
          if (distFromCenter <= 2.8) {
            pixels[pIdx] = 50; pixels[pIdx+1] = 130; pixels[pIdx+2] = 200;
          } else if (ly < -hh + 2) {
            const btn = (Math.floor(lx) % 2 === 0);
            pixels[pIdx] = btn ? 230 : 100;
            pixels[pIdx+1] = btn ? 50 : 100;
            pixels[pIdx+2] = btn ? 50 : 110;
          } else {
            pixels[pIdx] = 220; pixels[pIdx+1] = 225; pixels[pIdx+2] = 230;
          }
        }
        break;

      case 'clock':
        const r = Math.hypot(lx, ly);
        if (r >= hw - 0.8) {
          pixels[pIdx] = 180; pixels[pIdx+1] = 120; pixels[pIdx+2] = 40;
        } else if (Math.abs(lx) <= 0.6 || Math.abs(ly) <= 0.6) {
          pixels[pIdx] = 20; pixels[pIdx+1] = 20; pixels[pIdx+2] = 20;
        } else {
          pixels[pIdx] = 240; pixels[pIdx+1] = 240; pixels[pIdx+2] = 230;
        }
        break;

      case 'fridge':
        if (isEdge) {
          pixels[pIdx] = 210; pixels[pIdx+1] = 212; pixels[pIdx+2] = 215;
        } else if (ly < -hh + 4 && ly > -hh + 3) {
          pixels[pIdx] = 120; pixels[pIdx+1] = 122; pixels[pIdx+2] = 125;
        } else if (lx > hw - 2.5 && ly < 0) {
          pixels[pIdx] = 160; pixels[pIdx+1] = 165; pixels[pIdx+2] = 170;
        } else {
          pixels[pIdx] = 235; pixels[pIdx+1] = 238; pixels[pIdx+2] = 240;
        }
        break;

      case 'sofa':
        if (isEdge) {
          pixels[pIdx] = 60; pixels[pIdx+1] = 40; pixels[pIdx+2] = 70;
        } else if (ly < -hh + 3) {
          pixels[pIdx] = 90; pixels[pIdx+1] = 60; pixels[pIdx+2] = 110;
        } else {
          const cushion = Math.floor((lx + hw) / (f.w / 3));
          const shade = cushion % 2 === 0 ? 130 : 115;
          pixels[pIdx] = shade; pixels[pIdx+1] = shade * 0.65; pixels[pIdx+2] = shade + 30;
        }
        break;

      case 'sink':
        if (isEdge) {
          pixels[pIdx] = 150; pixels[pIdx+1] = 150; pixels[pIdx+2] = 155;
        } else {
          const basin = Math.hypot(lx, ly) <= Math.min(hw, hh) - 1.5;
          if (basin) { pixels[pIdx] = 70; pixels[pIdx+1] = 100; pixels[pIdx+2] = 130; }
          else { pixels[pIdx] = 210; pixels[pIdx+1] = 212; pixels[pIdx+2] = 215; }
        }
        break;

      case 'plant':
        if (ly > hh - 3) {
          pixels[pIdx] = 150; pixels[pIdx+1] = 90; pixels[pIdx+2] = 50;
        } else {
          const leaf = ((Math.floor(lx * 1.3) + Math.floor(ly * 1.3)) % 3 === 0);
          pixels[pIdx] = leaf ? 30 : 50;
          pixels[pIdx+1] = leaf ? 110 : 150;
          pixels[pIdx+2] = leaf ? 40 : 60;
        }
        break;

      case 'tree': {
        const trunkW = hw * 0.35;
        if (Math.abs(lx) <= trunkW && ly > hh * 0.15) {
          // 幹
          pixels[pIdx] = 90; pixels[pIdx+1] = 60; pixels[pIdx+2] = 35;
        } else {
          // 葉（円形、少しノイズをつけて自然に）。円の外は何も描かず背景を活かす
          const rr = Math.hypot(lx, ly * 0.9 - hh * 0.05);
          if (rr <= hw - 0.5) {
            const speck = ((Math.floor(lx * 1.7) + Math.floor(ly * 1.7)) % 4 === 0);
            pixels[pIdx] = speck ? 20 : 30;
            pixels[pIdx+1] = speck ? 100 : 130;
            pixels[pIdx+2] = speck ? 35 : 45;
          }
        }
        break;
      }

      case 'lamp': {
        const poleW = hw * 0.3;
        if (ly > -hh + 3 && Math.abs(lx) <= poleW) {
          // 支柱
          pixels[pIdx] = 60; pixels[pIdx+1] = 60; pixels[pIdx+2] = 65;
        } else if (ly <= -hh + 3) {
          // 灯り部分（暖色に光る）。円の外は何も描かず背景を活かす
          const glow = Math.hypot(lx, ly + hh - 1.5) <= hw - 0.5;
          if (glow) {
            pixels[pIdx] = 255; pixels[pIdx+1] = 220; pixels[pIdx+2] = 140;
          } else {
            pixels[pIdx] = 50; pixels[pIdx+1] = 50; pixels[pIdx+2] = 55;
          }
        }
        break;
      }
    }
  });
}

// --- 描画メインループ ---
function render() {
  // 燃え尽きた木壁を自動削除
  walls = walls.filter(w => w.type !== 'wood' || w.hp === undefined || w.hp > 0);

  // 火災ゲージのUI更新
  updateFireGauge();

  // 1. 背景描画
  const isOutdoor = mapEnvironment === 'outdoor';
  for (let y = 0; y < HEIGHT; y++) {
    for (let x = 0; x < WIDTH; x++) {
      const idx = (y * WIDTH + x) * 4;
      const isGrid = (x % 16 === 0 || y % 16 === 0);
      if (isOutdoor) {
        // 屋外: 草地っぽい緑系の背景（軽いノイズでムラをつける）
        const noise = ((x * 13 + y * 7) % 9);
        pixels[idx]     = 10 + noise;
        pixels[idx + 1] = (isGrid ? 34 : 28) + noise;
        pixels[idx + 2] = 12 + noise * 0.5;
      } else {
        pixels[idx]     = isGrid ? 8  : 3;
        pixels[idx + 1] = isGrid ? 20 : 8;
        pixels[idx + 2] = isGrid ? 12 : 5;
      }
      pixels[idx + 3] = 255;
    }
  }

  // 2. 壁
  walls.forEach(w => {
    const type = w.type || 'concrete';
    const len = Math.hypot(w.x2 - w.x1, w.y2 - w.y1);
    const steps = Math.max(1, Math.ceil(len));

    let r = 80, g = 85, b = 90;
    if (type === 'brick') { r = 160; g = 60; b = 45; }
    else if (type === 'wood') {
      const hpRatio = (w.hp !== undefined) ? Math.max(0, w.hp / 100) : 1.0;
      r = Math.floor(130 * hpRatio + 30 * (1 - hpRatio));
      g = Math.floor(85 * hpRatio + 15 * (1 - hpRatio));
      b = Math.floor(45 * hpRatio + 10 * (1 - hpRatio));
    }
    else if (type === 'glass') { r = 100; g = 200; b = 240; }

    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const px = Math.floor(w.x1 + (w.x2 - w.x1) * t);
      const py = Math.floor(w.y1 + (w.y2 - w.y1) * t);

      for (let tx = -1; tx <= 1; tx++) {
        for (let ty = -1; ty <= 1; ty++) {
          const lx = px + tx;
          const ly = py + ty;
          if (lx >= 0 && lx < WIDTH && ly >= 0 && ly < HEIGHT) {
            const pIdx = (ly * WIDTH + lx) * 4;
            if (type === 'glass' && tx === 0 && ty === 0) {
              pixels[pIdx]     = 180;
              pixels[pIdx + 1] = 230;
              pixels[pIdx + 2] = 255;
            } else {
              pixels[pIdx]     = r;
              pixels[pIdx + 1] = g;
              pixels[pIdx + 2] = b;
            }
          }
        }
      }
    }
  });

  // 3. ドア
  doors.forEach(d => {
    const doorEnd = d.getEndPos();
    const dx = doorEnd.x - d.hx;
    const dy = doorEnd.y - d.hy;
    const steps = Math.ceil(d.length);

    let dr = 110, dg = 70, db = 35;
    if (d.type === 'iron') { dr = 140; dg = 150; db = 160; }

    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const px = Math.floor(d.hx + dx * t);
      const py = Math.floor(d.hy + dy * t);

      for (let tx = -1; tx <= 1; tx++) {
        for (let ty = -1; ty <= 1; ty++) {
          const lx = px + tx;
          const ly = py + ty;
          if (lx >= 0 && lx < WIDTH && ly >= 0 && ly < HEIGHT) {
            const pIdx = (ly * WIDTH + lx) * 4;
            pixels[pIdx]     = dr;
            pixels[pIdx + 1] = dg;
            pixels[pIdx + 2] = db;
          }
        }
      }
    }

    const knob = d.getKnobPos();
    const kx = Math.floor(knob.x);
    const ky = Math.floor(knob.y);
    for (let oy = -1; oy <= 1; oy++) {
      for (let ox = -1; ox <= 1; ox++) {
        const px = kx + ox;
        const py = ky + oy;
        if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
          const pIdx = (py * WIDTH + px) * 4;
          pixels[pIdx]     = d.isHeld ? 0 : (d.type === 'iron' ? 220 : 255);
          pixels[pIdx + 1] = d.isHeld ? 255 : (d.type === 'iron' ? 220 : 215);
          pixels[pIdx + 2] = d.isHeld ? 150 : (d.type === 'iron' ? 220 : 0);
        }
      }
    }
  });

  // 4. 家具
  furnitures.forEach(f => renderFurniture(f));

  // 5. 木箱
  boxes.forEach(box => {
    const half = Math.floor(box.size / 2);
    const renderY = box.isCarried ? box.y - 2 : box.y;

    for (let oy = -half; oy <= half; oy++) {
      for (let ox = -half; ox <= half; ox++) {
        const px = Math.floor(box.x) + ox;
        const py = Math.floor(renderY) + oy;

        if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
          const pIdx = (py * WIDTH + px) * 4;
          const isBorder = (Math.abs(ox) === half || Math.abs(oy) === half);
          pixels[pIdx]     = isBorder ? 60 : 120;
          pixels[pIdx + 1] = isBorder ? 35 : 75;
          pixels[pIdx + 2] = isBorder ? 15 : 35;
        }
      }
    }
  });

  // 6. 消火器
  extinguishers.forEach(ext => {
    const renderX = Math.floor(ext.x);
    const renderY = Math.floor(ext.isCarried ? ext.y - 2 : ext.y);

    for (let dy = -4; dy <= 4; dy++) {
      for (let dx = -2; dx <= 1; dx++) {
        const px = renderX + dx;
        const py = renderY + dy;

        if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
          const pIdx = (py * WIDTH + px) * 4;
          if (dy <= -2) {
            pixels[pIdx]     = (dx === 1 && dy === -3) ? 180 : 30;
            pixels[pIdx + 1] = (dx === 1 && dy === -3) ? 180 : 30;
            pixels[pIdx + 2] = (dx === 1 && dy === -3) ? 180 : 30;
          } else {
            const isEdge = (dx === -2 || dx === 1 || dy === 4);
            pixels[pIdx]     = isEdge ? 160 : 230;
            pixels[pIdx + 1] = isEdge ? 10  : 30;
            pixels[pIdx + 2] = isEdge ? 10  : 30;
          }
        }
      }
    }
  });

  // 7. 縄アイテム
  ropes.forEach(r => {
    const rx = Math.floor(r.x);
    const ry = Math.floor(r.isCarried ? r.y - 2 : r.y);

    for (let theta = 0; theta < Math.PI * 4.5; theta += 0.22) {
      const rad = 0.6 + theta * 0.7;
      const px = Math.floor(rx + Math.cos(theta) * rad);
      const py = Math.floor(ry + Math.sin(theta) * rad * 0.75);

      if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
        const pIdx = (py * WIDTH + px) * 4;
        pixels[pIdx]     = 210;
        pixels[pIdx + 1] = 160;
        pixels[pIdx + 2] = 75;
      }
    }
  });

  // 8. 炎
  fires.forEach(fire => {
    fire.update();
    const currentRadius = fire.radius;
    const rCeil = Math.ceil(currentRadius);
    const fx = Math.floor(fire.x);
    const fy = Math.floor(fire.y);

    for (let dy = -rCeil; dy <= rCeil; dy++) {
      for (let dx = -rCeil; dx <= rCeil; dx++) {
        const px = fx + dx;
        const py = fy + dy;

        if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
          const dist = Math.hypot(dx, dy);
          if (dist <= currentRadius) {
            const pIdx = (py * WIDTH + px) * 4;
            const normDist = dist / currentRadius;
            const flicker = Math.random();

            if (normDist < 0.35 && flicker > 0.2) {
              pixels[pIdx]     = 255;
              pixels[pIdx + 1] = 255;
              pixels[pIdx + 2] = 150;
            } else if (normDist < 0.75 && flicker > 0.15) {
              pixels[pIdx]     = 255;
              pixels[pIdx + 1] = 120 + Math.floor(Math.random() * 60);
              pixels[pIdx + 2] = 20;
            } else if (flicker > 0.3) {
              pixels[pIdx]     = 200 + Math.floor(Math.random() * 55);
              pixels[pIdx + 1] = 30;
              pixels[pIdx + 2] = 10;
            }
          }
        }
      }
    }
  });

  // 8.5 煙（炎から発生し、風向きに流されながら漂う）
  for (let i = smokeParticles.length - 1; i >= 0; i--) {
    const sp = smokeParticles[i];
    sp.update();
    if (sp.life <= 0) { smokeParticles.splice(i, 1); continue; }

    const sx = Math.floor(sp.x);
    const sy = Math.floor(sp.y);
    const r = Math.ceil(sp.radius);
    const baseAlpha = Math.min(0.5, sp.life * 0.5);

    for (let dy = -r; dy <= r; dy++) {
      for (let dx = -r; dx <= r; dx++) {
        const px = sx + dx;
        const py = sy + dy;
        if (px < 0 || px >= WIDTH || py < 0 || py >= HEIGHT) continue;
        const distSq = dx * dx + dy * dy;
        if (distSq > sp.radius * sp.radius) continue;
        const falloff = 1 - Math.sqrt(distSq) / sp.radius;
        const alpha = baseAlpha * falloff * 0.6;
        if (alpha <= 0.01) continue;
        const pIdx = (py * WIDTH + px) * 4;
        const gray = 50;
        pixels[pIdx]     += (gray - pixels[pIdx])     * alpha;
        pixels[pIdx + 1] += (gray - pixels[pIdx + 1]) * alpha;
        pixels[pIdx + 2] += (gray - pixels[pIdx + 2]) * alpha;
      }
    }
  }

  // 火災数チェックによるゲームオーバー判定
  if (!isEditMode && isClearMode && fires.length >= maxFireLimit) {
    isGameOver = true;
  }

  // クリア判定 (クリア有りモード時: 全バンディット無力化 && 全ての炎消火)
  if (!isEditMode && isClearMode && !isGameOver && !isGameClear) {
    const allBanditsNeutralized = bandits.length > 0 && bandits.every(b => b.isNeutralized);
    if (allBanditsNeutralized && fires.length === 0) {
      isGameClear = true;
    }
  }

  // 9. 消防士 (味方NPC) 描画
  firefighters.forEach(ff => {
    ff.update();
    const ffNodes = ff.getNodes();

    const ffAlphaBuffer = new Float32Array(WIDTH * HEIGHT);
    ff.particles.forEach(p => {
      p.update(ffNodes[p.nodeName], ff.angle, ffNodes.spd, false);

      const px = Math.floor(p.x);
      const py = Math.floor(p.y);
      const r = Math.ceil(p.radius);

      for (let dy = -r; dy <= r; dy++) {
        for (let dx = -r; dx <= r; dx++) {
          const x = px + dx;
          const y = py + dy;

          if (x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT) {
            const distSq = dx * dx + dy * dy;
            if (distSq < p.radius * p.radius) {
              const intense = (1 - Math.sqrt(distSq) / p.radius) * 58;
              ffAlphaBuffer[y * WIDTH + x] += intense;
            }
          }
        }
      }
    });

    for (let y = 0; y < HEIGHT; y++) {
      for (let x = 0; x < WIDTH; x++) {
        const idx = y * WIDTH + x;
        const alpha = ffAlphaBuffer[idx];
        if (alpha <= 4) continue;

        const pIdx = idx * 4;
        const randomVal = Math.random() * 110;

        const hDx = x - ffNodes.head.x;
        const hDy = y - ffNodes.head.y;
        const isHeadCenter = (hDx * hDx + hDy * hDy) < 2.0;

        if (isHeadCenter && alpha > 35) {
          // ヘルメット（黄色）
          pixels[pIdx]     = 255; pixels[pIdx + 1] = 220; pixels[pIdx + 2] = 0;
        } else if (alpha > 90) {
          // 防火服（オレンジ）
          pixels[pIdx]     = 240; pixels[pIdx + 1] = 100; pixels[pIdx + 2] = 20;
        } else if (randomVal < alpha) {
          if (alpha > 30) {
            pixels[pIdx]     = 200; pixels[pIdx + 1] = 130; pixels[pIdx + 2] = 30;
          } else {
            pixels[pIdx]     = 100; pixels[pIdx + 1] = 40;  pixels[pIdx + 2] = 10;
          }
        }
      }
    }

    // 手元の標準装備消火器
    const extX = Math.floor(ffNodes.rHand.x);
    const extY = Math.floor(ffNodes.rHand.y);
    for (let dy = -2; dy <= 2; dy++) {
      for (let dx = -2; dx <= 2; dx++) {
        const px = extX + dx;
        const py = extY + dy;
        if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
          const pIdx = (py * WIDTH + px) * 4;
          pixels[pIdx]     = 230;
          pixels[pIdx + 1] = 30;
          pixels[pIdx + 2] = 30;
        }
      }
    }
  });

  // 10. バンディット (放火魔NPC)
  bandits.forEach(b => {
    b.update();
    const bNodes = b.getNodes();

    if (b.isNeutralized) {
      const bx = Math.floor(b.x);
      const by = Math.floor(b.y);

      for (let oy = -6; oy <= 6; oy++) {
        for (let ox = -6; ox <= 6; ox++) {
          const px = bx + ox;
          const py = by + oy;
          if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
            const pIdx = (py * WIDTH + px) * 4;
            const isBorder = (Math.abs(ox) === 6 || Math.abs(oy) === 6);
            pixels[pIdx]     = isBorder ? 70 : 130;
            pixels[pIdx + 1] = isBorder ? 40 : 80;
            pixels[pIdx + 2] = isBorder ? 15 : 35;
          }
        }
      }
    }

    const alphaBuffer = new Float32Array(WIDTH * HEIGHT);
    b.particles.forEach(p => {
      p.update(bNodes[p.nodeName], b.angle, bNodes.spd, false);

      const px = Math.floor(p.x);
      const py = Math.floor(p.y);
      const r = Math.ceil(p.radius);

      for (let dy = -r; dy <= r; dy++) {
        for (let dx = -r; dx <= r; dx++) {
          const x = px + dx;
          const y = py + dy;

          if (x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT) {
            const distSq = dx * dx + dy * dy;
            if (distSq < p.radius * p.radius) {
              const intense = (1 - Math.sqrt(distSq) / p.radius) * 58;
              alphaBuffer[y * WIDTH + x] += intense;
            }
          }
        }
      }
    });

    for (let y = 0; y < HEIGHT; y++) {
      for (let x = 0; x < WIDTH; x++) {
        const idx = y * WIDTH + x;
        const alpha = alphaBuffer[idx];
        if (alpha <= 4) continue;

        const pIdx = idx * 4;
        const randomVal = Math.random() * 110;

        const hDx = x - bNodes.head.x;
        const hDy = y - bNodes.head.y;
        const isEye = (hDx * hDx + hDy * hDy) < 1.2;

        if (isEye) {
          pixels[pIdx]     = 255; pixels[pIdx + 1] = 30;  pixels[pIdx + 2] = 30;
        } else if (alpha > 80) {
          pixels[pIdx]     = 35;  pixels[pIdx + 1] = 35;  pixels[pIdx + 2] = 45;
        } else if (randomVal < alpha) {
          pixels[pIdx]     = 15;  pixels[pIdx + 1] = 15;  pixels[pIdx + 2] = 20;
        }
      }
    }

    if (b.isTied || b.isNeutralized) {
      const bx = Math.floor(b.x);
      const by = Math.floor(b.y);

      const ringCount = b.isNeutralized ? 5 : 4;
      for (let ring = -ringCount; ring <= ringCount; ring += 2) {
        for (let a = 0; a < Math.PI * 2; a += 0.3) {
          const rx = Math.floor(bx + Math.cos(a) * (b.isNeutralized ? 6.5 : 5.0));
          const ry = Math.floor(by + ring + Math.sin(a) * 2.2);

          if (rx >= 0 && rx < WIDTH && ry >= 0 && ry < HEIGHT) {
            const pIdx = (ry * WIDTH + rx) * 4;
            pixels[pIdx]     = 230;
            pixels[pIdx + 1] = 180;
            pixels[pIdx + 2] = 80;
          }
        }
      }
    }
  });

  // 11. プレイヤー描画
  const { speed, isDashing, rReachProgress, nodes } = player.update();
  const playerAlphaBuffer = new Float32Array(WIDTH * HEIGHT);

  playerParticles.forEach(p => {
    p.update(nodes[p.nodeName], player.angle, speed, isDashing);

    const px = Math.floor(p.x);
    const py = Math.floor(p.y);
    const r = Math.ceil(p.radius);

    for (let dy = -r; dy <= r; dy++) {
      for (let dx = -r; dx <= r; dx++) {
        const x = px + dx;
        const y = py + dy;

        if (x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT) {
          const distSq = dx * dx + dy * dy;
          if (distSq < p.radius * p.radius) {
            const intense = (1 - Math.sqrt(distSq) / p.radius) * 58;
            playerAlphaBuffer[y * WIDTH + x] += intense;
          }
        }
      }
    }
  });

  for (let y = 0; y < HEIGHT; y++) {
    for (let x = 0; x < WIDTH; x++) {
      const idx = y * WIDTH + x;
      const alpha = playerAlphaBuffer[idx];
      if (alpha <= 4) continue;

      const pIdx = idx * 4;
      const randomVal = Math.random() * 110;

      const hDx = x - nodes.head.x;
      const hDy = y - nodes.head.y;
      const isHeadCenter = (hDx * hDx + hDy * hDy) < 2.0;

      if (isHeadCenter && alpha > 35) {
        pixels[pIdx]     = 230; pixels[pIdx + 1] = 255; pixels[pIdx + 2] = 240;
      } else if (alpha > 90) {
        pixels[pIdx]     = 180; pixels[pIdx + 1] = 255; pixels[pIdx + 2] = 200;
      } else if (randomVal < alpha) {
        if (alpha > 30) {
          pixels[pIdx]     = 0;   pixels[pIdx + 1] = 225; pixels[pIdx + 2] = 110;
        } else {
          pixels[pIdx]     = 10;  pixels[pIdx + 1] = 75;  pixels[pIdx + 2] = 40;
        }
      }
    }
  }

  // 12. 消火泡（炎の消火 & 敵への吹きつけ判定）
  for (let i = foamParticles.length - 1; i >= 0; i--) {
    const fp = foamParticles[i];
    fp.update();

    // 炎への消火
    for (let j = fires.length - 1; j >= 0; j--) {
      const fire = fires[j];
      const fireRadius = fire.radius;
      if (Math.hypot(fp.x - fire.x, fp.y - fire.y) < fireRadius + fp.radius) {
        // 消防士NPCの泡はプレイヤーより消火速度を遅くする
        const extinguishPower = fp.isFirefighter ? 0.22 : 1.0;
        fire.hp -= 3.5 * extinguishPower;
        fire.radius -= 0.15 * extinguishPower;
        fp.life = 0;
        break;
      }
    }

    // 敵（バンディット）への吹きつけ判定（走って逃走＆20秒間救援停止）
    // ※仲間の救出を試みている最中のバンディットにしか効果がない
    if (fp.life > 0) {
      for (let b of bandits) {
        if (!b.isNeutralized && !b.isTied && b.rescuingTarget) {
          if (Math.hypot(fp.x - b.x, fp.y - b.y) < fp.radius + 6.0) {
            b.hitByExtinguisher(fp.x, fp.y);
            fp.life = 0;
            break;
          }
        }
      }
    }

    if (fp.life <= 0) {
      foamParticles.splice(i, 1);
      continue;
    }

    const px = Math.floor(fp.x);
    const py = Math.floor(fp.y);
    const r = Math.ceil(fp.radius);

    for (let dy = -r; dy <= r; dy++) {
      for (let dx = -r; dx <= r; dx++) {
        const lx = px + dx;
        const ly = py + dy;

        if (lx >= 0 && lx < WIDTH && ly >= 0 && ly < HEIGHT) {
          if (dx * dx + dy * dy <= fp.radius * fp.radius) {
            const pIdx = (ly * WIDTH + lx) * 4;
            const intense = fp.life;
            pixels[pIdx]     = Math.min(255, pixels[pIdx]     + 220 * intense);
            pixels[pIdx + 1] = Math.min(255, pixels[pIdx + 1] + 240 * intense);
            pixels[pIdx + 2] = Math.min(255, pixels[pIdx + 2] + 255 * intense);
          }
        }
      }
    }
  }

  // 13. 縄破片
  for (let i = ropeCutParticles.length - 1; i >= 0; i--) {
    const rp = ropeCutParticles[i];
    rp.update();
    if (rp.life <= 0) { ropeCutParticles.splice(i, 1); continue; }

    const px = Math.floor(rp.x);
    const py = Math.floor(rp.y);
    if (px >= 0 && px < WIDTH && py >= 0 && py < HEIGHT) {
      const pIdx = (py * WIDTH + px) * 4;
      pixels[pIdx]     = 210;
      pixels[pIdx + 1] = 160;
      pixels[pIdx + 2] = 80;
    }
  }

  const prevFireCount = fires.length;
  fires = fires.filter(f => f.hp > 0 && f.radius > 1.0);
  if (prevFireCount !== fires.length && isEditMode) updateStats();

  // 14. ライティング
  if (isEditMode) {
    lightMap.fill(1.0);
  } else {
    lightMap.fill(0.08);

    const px = player.x;
    const py = player.y;
    const playerVisionR = 30;
    const minX = Math.max(0, Math.floor(px - playerVisionR));
    const maxX = Math.min(WIDTH - 1, Math.ceil(px + playerVisionR));
    const minY = Math.max(0, Math.floor(py - playerVisionR));
    const maxY = Math.min(HEIGHT - 1, Math.ceil(py + playerVisionR));

    for (let ly = minY; ly <= maxY; ly++) {
      for (let lx = minX; lx <= maxX; lx++) {
        const d = Math.hypot(lx - px, ly - py);
        if (d < playerVisionR) {
          const factor = (1 - d / playerVisionR) * 0.48;
          const idx = ly * WIDTH + lx;
          lightMap[idx] = Math.max(lightMap[idx], 0.08 + factor);
        }
      }
    }

    if (rReachProgress > 0.01) {
      const lightSourceX = nodes.rHand.x;
      const lightSourceY = nodes.rHand.y;
      const lightAngle = player.angle;
      const maxRange = 95 * rReachProgress;
      const fov = 0.52;

      const lMinX = Math.max(0, Math.floor(lightSourceX - maxRange));
      const lMaxX = Math.min(WIDTH - 1, Math.ceil(lightSourceX + maxRange));
      const lMinY = Math.max(0, Math.floor(lightSourceY - maxRange));
      const lMaxY = Math.min(HEIGHT - 1, Math.ceil(lightSourceY + maxRange));

      for (let ly = lMinY; ly <= lMaxY; ly++) {
        for (let lx = lMinX; lx <= lMaxX; lx++) {
          const dx = lx - lightSourceX;
          const dy = ly - lightSourceY;
          const dist = Math.hypot(dx, dy);

          if (dist > 0 && dist < maxRange) {
            const pAngle = Math.atan2(dy, dx);
            let diff = pAngle - lightAngle;
            while (diff < -Math.PI) diff += Math.PI * 2;
            while (diff > Math.PI) diff -= Math.PI * 2;

            if (Math.abs(diff) < fov) {
              const distFactor = 1.0 - (dist / maxRange);
              const angleFactor = 1.0 - (Math.abs(diff) / fov);
              const intensity = distFactor * angleFactor * rReachProgress * 1.45;
              const flicker = 0.88 + Math.random() * 0.24;

              const idx = ly * WIDTH + lx;
              lightMap[idx] = Math.min(1.5, lightMap[idx] + intensity * flicker);
            }
          }
        }
      }
    }

    fires.forEach(fire => {
      const fireLightR = 25 + fire.radius * 2.2;
      const fx = fire.x;
      const fy = fire.y;
      const fMinX = Math.max(0, Math.floor(fx - fireLightR));
      const fMaxX = Math.min(WIDTH - 1, Math.ceil(fx + fireLightR));
      const fMinY = Math.max(0, Math.floor(fy - fireLightR));
      const fMaxY = Math.min(HEIGHT - 1, Math.ceil(fy + fireLightR));

      for (let ly = fMinY; ly <= fMaxY; ly++) {
        for (let lx = fMinX; lx <= fMaxX; lx++) {
          const d = Math.hypot(lx - fx, ly - fy);
          if (d < fireLightR) {
            const intensity = (1 - d / fireLightR) * 0.9 * (0.82 + Math.random() * 0.35);
            const idx = ly * WIDTH + lx;
            lightMap[idx] = Math.min(1.6, lightMap[idx] + intensity);
          }
        }
      }
    });
  }

  for (let y = 0; y < HEIGHT; y++) {
    for (let x = 0; x < WIDTH; x++) {
      const idx = y * WIDTH + x;
      const lm = lightMap[idx];
      const pIdx = idx * 4;

      pixels[pIdx]     = Math.min(255, pixels[pIdx]     * lm);
      pixels[pIdx + 1] = Math.min(255, pixels[pIdx + 1] * lm);
      pixels[pIdx + 2] = Math.min(255, pixels[pIdx + 2] * lm);
    }
  }

  ctx.putImageData(imgData, 0, 0);

  // 15. オーバーレイ描画
  ctx.save();

  // バンディットのUI（救出バー・逃走状態など）描画
  if (!isEditMode && !isGameOver && !isGameClear) {
    bandits.forEach(b => {
      // 救援停止・逃走中の20秒タイマー表示
      if (b.rescueCooldownTimer > 0 && !b.isTied && !b.isNeutralized) {
        ctx.fillStyle = '#ffaa00';
        ctx.font = '8px monospace';
        ctx.textAlign = 'center';
        const remainingSec = Math.ceil(b.rescueCooldownTimer / 60);
        ctx.fillText(`!? ${remainingSec}s`, b.x, b.y - 10);
      }

      // 救出ゲージ
      if (b.rescueTimer > 0 && b.rescuingTarget) {
        const target = b.rescuingTarget;
        const progress = b.rescueTimer / 300; // 5秒
        const barWidth = 16;
        const barHeight = 3;
        const bx = target.x - barWidth / 2;
        const by = target.y - 12;

        ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
        ctx.fillRect(bx - 1, by - 1, barWidth + 2, barHeight + 2);

        ctx.fillStyle = '#ffaa00';
        ctx.fillRect(bx, by, barWidth * progress, barHeight);

        ctx.strokeStyle = 'rgba(255, 170, 0, 0.6)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(b.x, b.y);
        ctx.lineTo(target.x, target.y);
        ctx.stroke();
      }
    });
  }

  // エディタオーバーレイ描画
  if (isEditMode) {
    ctx.strokeStyle = '#00ffff';
    ctx.fillStyle = '#00ffff';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(spawnPoint.x, spawnPoint.y, 5, 0, Math.PI * 2);
    ctx.stroke();
    ctx.font = '9px monospace';
    ctx.fillText('S', spawnPoint.x - 2.5, spawnPoint.y + 3);

    if (snapToGrid) {
      ctx.strokeStyle = 'rgba(0, 255, 102, 0.15)';
      ctx.lineWidth = 0.5;
      for (let x = 0; x < WIDTH; x += 8) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, HEIGHT); ctx.stroke();
      }
      for (let y = 0; y < HEIGHT; y += 8) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(WIDTH, y); ctx.stroke();
      }
    }

    if (wallStartPoint && isMouseInCanvas) {
      ctx.strokeStyle = '#ff3366';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(wallStartPoint.x, wallStartPoint.y);
      ctx.lineTo(currentMousePos.x, currentMousePos.y);
      ctx.stroke();
    }

    // 家具・ドア配置時の半透明プレビュー＋向き表示
    if (isMouseInCanvas && !wallStartPoint && !templateCaptureStart) {
      if (furnitureTypes.includes(currentTool)) {
        const tmp = new Furniture(currentTool, currentMousePos.x, currentMousePos.y, itemRotateAngle);
        ctx.save();
        ctx.globalAlpha = 0.55;
        ctx.translate(tmp.x, tmp.y);
        ctx.rotate(tmp.angle);
        ctx.fillStyle = '#66ffcc';
        ctx.fillRect(-tmp.w / 2, -tmp.h / 2, tmp.w, tmp.h);
        ctx.restore();

        // 向き（正面）を示す矢印
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(tmp.x, tmp.y);
        ctx.lineTo(tmp.x + Math.cos(tmp.angle) * (tmp.w / 2 + 5), tmp.y + Math.sin(tmp.angle) * (tmp.h / 2 + 5));
        ctx.stroke();
      } else if (currentTool === 'door') {
        const previewAngle = itemRotateAngle;
        const len = 22;
        const ex = currentMousePos.x + Math.cos(previewAngle) * len;
        const ey = currentMousePos.y + Math.sin(previewAngle) * len;
        ctx.save();
        ctx.globalAlpha = 0.55;
        ctx.strokeStyle = '#ffaa55';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(currentMousePos.x, currentMousePos.y);
        ctx.lineTo(ex, ey);
        ctx.stroke();
        ctx.restore();

        // ドアが開く向き（法線方向）を示す矢印
        const normalAngle = previewAngle + Math.PI / 2;
        const midX = (currentMousePos.x + ex) / 2;
        const midY = (currentMousePos.y + ey) / 2;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(midX, midY);
        ctx.lineTo(midX + Math.cos(normalAngle) * 8, midY + Math.sin(normalAngle) * 8);
        ctx.stroke();
      } else if (currentTool === 'erase') {
        ctx.strokeStyle = 'rgba(255, 60, 60, 0.7)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(currentMousePos.x, currentMousePos.y, 12, 0, Math.PI * 2);
        ctx.stroke();
      } else if (['spawn', 'box', 'extinguisher', 'fire', 'rope', 'bandit', 'firefighter'].includes(currentTool)) {
        ctx.save();
        ctx.globalAlpha = 0.55;
        ctx.fillStyle = '#66ffcc';
        ctx.beginPath();
        ctx.arc(currentMousePos.x, currentMousePos.y, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    if (templateCaptureStart && isMouseInCanvas) {
      ctx.strokeStyle = '#ffdd33';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 2]);
      const rx = Math.min(templateCaptureStart.x, currentMousePos.x);
      const ry = Math.min(templateCaptureStart.y, currentMousePos.y);
      const rw = Math.abs(currentMousePos.x - templateCaptureStart.x);
      const rh = Math.abs(currentMousePos.y - templateCaptureStart.y);
      ctx.strokeRect(rx, ry, rw, rh);
      ctx.setLineDash([]);
    }
  }

  // ゲームオーバー / クリア表示
  if (isGameOver) {
    gameOverAlpha = Math.min(0.85, gameOverAlpha + 0.02);
    ctx.fillStyle = `rgba(40, 0, 0, ${gameOverAlpha})`;
    ctx.fillRect(0, 0, WIDTH, HEIGHT);

    ctx.fillStyle = '#ff2200';
    ctx.font = 'bold 16px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('🔥 BURN OUT 🔥', WIDTH / 2, HEIGHT / 2 - 6);

    ctx.fillStyle = '#ffffff';
    ctx.font = '9px monospace';
    ctx.fillText('火災が限界を超えました [R]: リトライ', WIDTH / 2, HEIGHT / 2 + 10);
  } else if (isGameClear) {
    gameClearAlpha = Math.min(0.85, gameClearAlpha + 0.02);
    ctx.fillStyle = `rgba(0, 40, 10, ${gameClearAlpha})`;
    ctx.fillRect(0, 0, WIDTH, HEIGHT);

    ctx.fillStyle = '#00ff66';
    ctx.font = 'bold 16px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('🎉 MISSION CLEAR 🎉', WIDTH / 2, HEIGHT / 2 - 6);

    ctx.fillStyle = '#ffffff';
    ctx.font = '9px monospace';
    ctx.fillText('すべての鎮火と放火魔の無力化に成功！ [R]: リトライ', WIDTH / 2, HEIGHT / 2 + 10);
  }

  ctx.restore();

  updateEditorCameraPan();

  requestAnimationFrame(render);
}

loadTemplatesFromStorage();
refreshSlotSelect();
updateWindIndicator();

// ゲームループ起動
requestAnimationFrame(render);
</script>
</body>
