<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>Top-Down Game - Bandit Coop Rescue & Burn Out System</title>
  <style>
    * { margin: 0; padding: 0; overflow: hidden; background: #030805; font-family: monospace; user-select: none; }
    
    #container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    canvas#stage {
      width: 100vw;
      height: 100vh;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      cursor: crosshair;
    }

    /* UI Layer */
    #ui-layer {
      position: absolute;
      top: 12px;
      left: 12px;
      color: #00ff66;
      font-size: 12px;
      pointer-events: none;
      line-height: 1.6;
      text-shadow: 0 0 4px #004411;
    }
    #ui-layer * { pointer-events: none; }
    #ui-drag-handle {
      display: inline-block;
      cursor: move;
      pointer-events: auto !important;
      background: rgba(0, 60, 30, 0.7);
      border: 1px solid #00ff66;
      border-radius: 3px;
      padding: 1px 5px;
      margin-right: 6px;
      font-size: 10px;
    }
    #ui-layer.edit-collapsed #fire-gauge-container,
    #ui-layer.edit-collapsed #wind-indicator-container,
    #ui-layer.edit-collapsed #controls-hint {
      display: none;
    }

    .badge {
      padding: 2px 6px;
      font-weight: bold;
      border-radius: 2px;
    }
    .play-badge { background: #00ff66; color: #000; }
    .edit-badge { background: #ff3366; color: #fff; }

    /* Map Editor Panel */
    #editor-panel {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 270px;
      background: rgba(0, 20, 10, 0.92);
      border: 1px solid #00ff66;
      color: #00ff66;
      padding: 12px;
      font-size: 11px;
      border-radius: 4px;
      display: none;
      box-shadow: 0 0 12px rgba(0,255,102,0.25);
      max-height: 90vh;
      overflow-y: auto;
    }

    #editor-panel h3 {
      margin-bottom: 8px;
      border-bottom: 1px solid #00ff66;
      padding-bottom: 4px;
      color: #ffffff;
      display: flex;
      justify-content: space-between;
    }

    .tool-group-title {
      font-weight: bold;
      color: #88ffaa;
      margin: 6px 0 3px 0;
      border-bottom: 1px dashed #00aa44;
      padding-bottom: 2px;
    }

    .tool-btn {
      display: block;
      width: 100%;
      background: #002b11;
      border: 1px solid #00aa44;
      color: #00ff66;
      padding: 4px 6px;
      margin-bottom: 3px;
      cursor: pointer;
      text-align: left;
      font-family: monospace;
      font-size: 10.5px;
      border-radius: 2px;
    }

    .tool-btn:hover { background: #005522; }
    .tool-btn.active { background: #00ff66; color: #000; font-weight: bold; }

    .danger-btn {
      background: #330011;
      border-color: #ff3366;
      color: #ff3366;
      margin-top: 6px;
    }
    .danger-btn:hover { background: #660022; color: #fff; }

    .opt-row {
      margin: 6px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    select, input[type="text"], input[type="number"] {
      background: #001a0a;
      border: 1px solid #00ff66;
      color: #00ff66;
      font-family: monospace;
      font-size: 11px;
      padding: 2px 4px;
      border-radius: 2px;
    }

    #editor-stats {
      font-size: 9px;
      color: #88ffaa;
      margin-bottom: 6px;
      padding: 4px;
      background: rgba(0,0,0,0.4);
      border-radius: 2px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2px 6px;
    }

    textarea#json-io {
      width: 100%;
      height: 45px;
      background: #001105;
      border: 1px solid #00AA44;
      color: #00ff66;
      font-size: 10px;
      resize: none;
      margin-top: 4px;
      box-sizing: border-box;
      padding: 4px;
    }

    .io-btn-group {
      display: flex;
      gap: 4px;
      margin-top: 4px;
    }

    .io-btn-group button {
      flex: 1;
      background: #003318;
      border: 1px solid #00ff66;
      color: #00ff66;
      padding: 4px;
      cursor: pointer;
      font-size: 10px;
    }
    .io-btn-group button:hover { background: #006633; }
  </style>
</head>
<body>
  <div id="container">
    <canvas id="stage"></canvas>

    <div id="ui-layer">
      <div><span id="ui-drag-handle" title="ドラッグして移動">✥ 移動</span>MODE: <span id="mode-label" class="badge play-badge">PLAY MODE</span> <span style="color:#aaa;">( [Tab] 切替 / [H] ヘルプ・エディタ非表示 )</span></div>
      
      <!-- 火災状況ゲージ -->
      <div id="fire-gauge-container" style="margin: 6px 0; background: rgba(0, 20, 10, 0.85); border: 1px solid #00ff66; padding: 4px 6px; border-radius: 4px; width: 210px;">
        <div style="display:flex; justify-content:space-between; font-size:10px; font-weight:bold; margin-bottom:2px;">
          <span>🔥 火災状況 (FIRE GAUGE)</span>
          <span id="fire-gauge-text">0 / 12</span>
        </div>
        <div style="width: 100%; background: #112211; height: 10px; border-radius: 2px; border: 1px solid #004422; overflow: hidden; position: relative;">
          <div id="fire-gauge-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #ffbb00, #ff2200); transition: width 0.1s ease;"></div>
        </div>
      </div>

      <!-- 風向きインジケーター -->
      <div id="wind-indicator-container" style="margin: 6px 0; background: rgba(0, 20, 10, 0.85); border: 1px solid #00ff66; padding: 4px 6px; border-radius: 4px; width: 210px; display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:10px; font-weight:bold;">💨 風向き (WIND)</span>
        <div style="display:flex; align-items:center; gap:5px;">
          <svg id="wind-arrow-svg" width="14" height="14" viewBox="0 0 24 24" style="transform: rotate(90deg); transition: transform 0.25s ease, opacity 0.25s ease;">
            <path d="M12 3 L12 21 M12 3 L6 10 M12 3 L18 10" stroke="#00ff66" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span id="wind-strength-label" style="font-size:9px; color:#88ffaa;">無風</span>
        </div>
      </div>

      <div id="controls-hint">
        [WASD]: 移動 | [Shift]: ダッシュ | <b style="color:#ffff00;">[F]: ライトON/OFF</b><br>
        [E]: 持つ/置く/ドア | <b style="color:#fff;">[Space]: 消火噴射 / 縄拘束</b><br>
        <b style="color:#00ff66;">[EDIT時 R]: 回転 | [PLAY時 終了時 R]: リトライ | [H]: ヘルプ/エディタ切替</b>
      </div>
    </div>

    <!-- MAP EDITOR PANEL -->
    <div id="editor-panel">
      <h3>🏗️ MAP EDITOR</h3>

      <div class="opt-row">
        <label>🎮 ゲームモード:</label>
        <select id="sel-game-mode" onchange="isClearMode = (this.value === 'clear')">
          <option value="clear">クリア有り (Clear Mode)</option>
          <option value="free">フリーモード (Free Mode)</option>
        </select>
      </div>

      <div class="opt-row">
        <label>📐 ステージサイズ:</label>
        <select id="sel-stage-size" onchange="changeStageSize(this.value)">
          <option value="240x180">標準 (240x180)</option>
          <option value="360x270">拡大 (360x270)</option>
          <option value="480x360">特大 (480x360)</option>
          <option value="600x450">超特大 (600x450)</option>
          <option value="720x540">最大 (720x540)</option>
        </select>
      </div>

      <div class="opt-row">
        <label>🧱 壁の種類:</label>
        <select id="sel-wall-type">
          <option value="concrete">コンクリート (Concrete)</option>
          <option value="brick">レンガ (Brick)</option>
          <option value="wood">木壁 [燃えて朽ちる] (Wood)</option>
          <option value="glass">ガラス (Glass)</option>
        </select>
      </div>

      <div class="opt-row">
        <label>🚪 ドアの種類:</label>
        <select id="sel-door-type">
          <option value="wood">木製ドア (Wood)</option>
          <option value="iron">鉄のドア (Iron)</option>
        </select>
      </div>

      <div class="opt-row">
        <label>🔥 限界火災数 (Burnout):</label>
        <input type="number" id="num-fire-limit" value="12" min="1" max="100" style="width: 50px;" onchange="maxFireLimit = parseInt(this.value) || 12">
      </div>

      <div class="opt-row">
        <label>🌳 環境 (Environment):</label>
        <select id="sel-environment" onchange="mapEnvironment = this.value; updateWindIndicator();">
          <option value="indoor">屋内 (Indoor)</option>
          <option value="outdoor">屋外 (Outdoor)</option>
        </select>
      </div>

      <div class="opt-row">
        <label>💨 風向き/風力 (Wind):</label>
        <input type="range" id="range-wind-angle" min="0" max="359" value="0" style="width: 60px;" oninput="windAngle = this.value * Math.PI / 180; updateWindDisplay();">
        <span id="wind-angle-display" style="font-size:10px; color:#88ffaa; width:26px; display:inline-block; text-align:right;">0°</span>
        <input type="number" id="num-wind-strength" value="0" min="0" max="10" style="width: 34px;" oninput="windStrength = parseFloat(this.value) || 0; updateWindDisplay();">
      </div>

      <div class="tool-group-title">🎥 カメラ (Editor View)</div>
      <div class="opt-row">
        <span style="font-size:11px; opacity:0.8;">矢印キー:移動　ホイール:ズーム</span>
      </div>
      <button class="tool-btn" onclick="resetEditorCamera()">📷 表示リセット (Reset View)</button>
      <button class="tool-btn" onclick="doUndo()">↩️ 元に戻す (Undo) [Ctrl+Z]</button>
      <button class="tool-btn" onclick="doRedo()">↪️ やり直し (Redo) [Ctrl+Y]</button>

      <div class="tool-group-title">🖼️ 部屋テンプレート</div>
      <button class="tool-btn" id="btn-tool-template-capture" onclick="setTool('template-capture')">📐 範囲を選んで登録</button>
      <button class="tool-btn" id="btn-tool-template-stamp" onclick="setTool('template-stamp')" disabled>🖨️ スタンプ配置</button>
      <div class="opt-row">
        <select id="sel-templates" onchange="selectTemplate(this.value)" style="width:100%;">
          <option value="">-- テンプレート一覧 --</option>
        </select>
      </div>
      <button class="tool-btn" onclick="deleteSelectedTemplate()">🗑️ 選択中テンプレを削除</button>

      <div class="tool-group-title">基本構造 & スポーン</div>
      <button class="tool-btn" id="btn-tool-spawn" onclick="setTool('spawn')">[S] スポーン位置 (Spawn)</button>
      <button class="tool-btn active" id="btn-tool-wall" onclick="setTool('wall')">[1] 壁作成 (Wall)</button>
      <button class="tool-btn" id="btn-tool-door" onclick="setTool('door')">[2] ドア設置 [R回転]</button>

      <div class="tool-group-title">家具アイテム [Rで回転]</div>
      <button class="tool-btn" id="btn-tool-desk" onclick="setTool('desk')">[3] 机 (Desk)</button>
      <button class="tool-btn" id="btn-tool-chair" onclick="setTool('chair')">[4] 椅子 (Chair)</button>
      <button class="tool-btn" id="btn-tool-bed" onclick="setTool('bed')">[5] ベッド (Bed)</button>
      <button class="tool-btn" id="btn-tool-shelf" onclick="setTool('shelf')">[6] 本棚/棚 (Shelf)</button>
      <button class="tool-btn" id="btn-tool-tv" onclick="setTool('tv')">[7] テレビ (TV)</button>
      <button class="tool-btn" id="btn-tool-phone" onclick="setTool('phone')">[8] 電話 (Phone)</button>
      <button class="tool-btn" id="btn-tool-washer" onclick="setTool('washer')">[9] 洗濯機 (Washer)</button>
      <button class="tool-btn" id="btn-tool-clock" onclick="setTool('clock')">[C] 時計 (Clock)</button>
      <button class="tool-btn" id="btn-tool-fridge" onclick="setTool('fridge')">冷蔵庫 (Fridge)</button>
      <button class="tool-btn" id="btn-tool-sofa" onclick="setTool('sofa')">ソファ (Sofa)</button>
      <button class="tool-btn" id="btn-tool-sink" onclick="setTool('sink')">シンク (Sink)</button>
      <button class="tool-btn" id="btn-tool-plant" onclick="setTool('plant')">観葉植物 (Plant)</button>

      <div class="tool-group-title">🌳 屋外アイテム</div>
      <button class="tool-btn" id="btn-tool-tree" onclick="setTool('tree')">木 (Tree)</button>
      <button class="tool-btn" id="btn-tool-lamp" onclick="setTool('lamp')">外灯 (Streetlamp)</button>

      <div class="tool-group-title">インタラクティブ / キャラクター</div>
      <button class="tool-btn" id="btn-tool-box" onclick="setTool('box')">木箱 (Box)</button>
      <button class="tool-btn" id="btn-tool-ext" onclick="setTool('extinguisher')">消火器 (Ext)</button>
      <button class="tool-btn" id="btn-tool-fire" onclick="setTool('fire')">炎 (Fire)</button>
      <button class="tool-btn" id="btn-tool-rope" onclick="setTool('rope')">縄 (Rope)</button>
      <button class="tool-btn" id="btn-tool-bandit" onclick="setTool('bandit')">バンディット (Bandit)</button>
      <button class="tool-btn" id="btn-tool-firefighter" onclick="setTool('firefighter')">消防士味方 (Firefighter)</button>
      <button class="tool-btn" id="btn-tool-erase" onclick="setTool('erase')">[0] 削除 (Erase)</button>

      <div class="opt-row">
        <label><input type="checkbox" id="chk-snap" checked> 8px グリッドスナップ</label>
      </div>

      <div id="editor-stats">
        <span>壁:<b id="stat-walls">0</b></span>
        <span>ドア:<b id="stat-doors">0</b></span>
        <span>家具:<b id="stat-furnitures">0</b></span>
        <span>箱:<b id="stat-boxes">0</b></span>
        <span>消火器:<b id="stat-exts">0</b></span>
        <span>炎:<b id="stat-fires">0</b></span>
        <span>縄:<b id="stat-ropes">0</b></span>
        <span>敵:<b id="stat-bandits">0</b></span>
        <span>味方:<b id="stat-firefighters">0</b></span>
      </div>

      <button class="tool-btn danger-btn" onclick="clearAllFires()" style="border-color: #ffaa00; color: #ffaa00; background: #221800;">🔥 火をすべて消す (Clear Fires)</button>
      <button class="tool-btn danger-btn" onclick="clearAllObjects()">🗑️ マップ全削除 (Clear All)</button>

      <hr style="border-color: #00aa44; margin: 6px 0;">

      <div>💾 マップデータ (JSON)</div>
      <textarea id="json-io" placeholder="JSONデータ..."></textarea>
      <div class="io-btn-group">
        <button onclick="exportMapData()">Export (出力)</button>
        <button onclick="importMapData()">Import (読み込み)</button>
      </div>

      <hr style="border-color: #00aa44; margin: 6px 0;">

      <div>🗂️ マップスロット保存 (ブラウザ内)</div>
      <div class="opt-row">
        <input type="text" id="input-slot-name" placeholder="スロット名..." style="flex:1;">
        <button onclick="saveMapSlot()">保存</button>
      </div>
      <div class="opt-row">
        <select id="sel-slots" style="width:100%;">
          <option value="">-- 保存済みマップ --</option>
        </select>
      </div>
      <div class="io-btn-group">
        <button onclick="loadMapSlot()">読み込み</button>
        <button onclick="deleteMapSlot()">削除</button>
      </div>
    </div>
  </div>

<script>
let WIDTH = 240;
let HEIGHT = 180;

// --- 環境・天候 ---
let mapEnvironment = 'indoor'; // 'indoor' | 'outdoor'
let windAngle = 0;    // ラジアン
let windStrength = 0; // 0-10

function updateWindDisplay() {
  const deg = Math.round(windAngle * 180 / Math.PI);
  const disp = document.getElementById('wind-angle-display');
  if (disp) disp.textContent = deg + '°';
  updateWindIndicator();
}

// 屋外の方が風の影響を強く受ける（屋内は建物に遮られるため弱める）
function getEffectiveWindStrength() {
  return windStrength * (mapEnvironment === 'outdoor' ? 1 : 0.25);
}

// UI上の風向き矢印・強さ表示を更新
function updateWindIndicator() {
  const arrow = document.getElementById('wind-arrow-svg');
  const label = document.getElementById('wind-strength-label');
  if (!arrow || !label) return;
  const deg = windAngle * 180 / Math.PI;
  arrow.style.transform = `rotate(${deg + 90}deg)`;
  if (windStrength <= 0) {
    label.textContent = '無風';
    arrow.style.opacity = '0.25';
  } else {
    const isOutdoor = mapEnvironment === 'outdoor';
    label.textContent = `${windStrength}${isOutdoor ? '' : ' (屋内で減衰)'}`;
    arrow.style.opacity = String(0.35 + 0.65 * Math.min(1, getEffectiveWindStrength() / 10));
  }
}

// --- エディタ用カメラ (パン & ズーム) ---
const editorCamera = { x: 0, y: 0, zoom: 1 };
const camKeys = { up: false, down: false, left: false, right: false };

function applyEditorCameraTransform() {
  if (!isEditMode) {
    canvas.style.transform = '';
    return;
  }
  const scaleX = window.innerWidth / WIDTH;
  const scaleY = window.innerHeight / HEIGHT;
  const tx = -editorCamera.x * scaleX;
  const ty = -editorCamera.y * scaleY;
  canvas.style.transformOrigin = '0 0';
  canvas.style.transform = `scale(${editorCamera.zoom}) translate(${tx}px, ${ty}px)`;
}

function clampEditorCamera() {
  const maxX = Math.max(0, WIDTH * (1 - 1 / editorCamera.zoom));
  const maxY = Math.max(0, HEIGHT * (1 - 1 / editorCamera.zoom));
  editorCamera.x = Math.max(0, Math.min(maxX, editorCamera.x));
  editorCamera.y = Math.max(0, Math.min(maxY, editorCamera.y));
}

function resetEditorCamera() {
  editorCamera.x = 0;
  editorCamera.y = 0;
  editorCamera.zoom = 1;
  applyEditorCameraTransform();
}

function setUiLayerEditVisibility(editMode) {
  const layer = document.getElementById('ui-layer');
  if (!layer) return;
  // 編集中は火災ゲージ・操作ヒントを畳んで、左上の視界を確保する
  if (editMode) layer.classList.add('edit-collapsed');
  else layer.classList.remove('edit-collapsed');
}

// --- 左上UIレイヤーのドラッグ移動 ---
(function setupUiLayerDrag() {
  const layer = document.getElementById('ui-layer');
  const handle = document.getElementById('ui-drag-handle');
  if (!layer || !handle) return;

  let dragging = false;
  let startMouseX = 0, startMouseY = 0, startLeft = 0, startTop = 0;

  handle.addEventListener('mousedown', e => {
    dragging = true;
    const rect = layer.getBoundingClientRect();
    startMouseX = e.clientX; startMouseY = e.clientY;
    startLeft = rect.left; startTop = rect.top;
    e.preventDefault();
  });

  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    const nx = startLeft + (e.clientX - startMouseX);
    const ny = startTop + (e.clientY - startMouseY);
    layer.style.left = Math.max(0, nx) + 'px';
    layer.style.top = Math.max(0, ny) + 'px';
  });

  window.addEventListener('mouseup', () => { dragging = false; });
})();

function updateEditorCameraPan() {
  if (!isEditMode) return;
  const panSpeed = 6 / editorCamera.zoom;
  if (camKeys.left) editorCamera.x -= panSpeed;
  if (camKeys.right) editorCamera.x += panSpeed;
  if (camKeys.up) editorCamera.y -= panSpeed;
  if (camKeys.down) editorCamera.y += panSpeed;
  if (camKeys.left || camKeys.right || camKeys.up || camKeys.down) {
    clampEditorCamera();
    applyEditorCameraTransform();
  }
}

// --- Undo / Redo ---
let undoStack = [];
let redoStack = [];
const UNDO_LIMIT = 30;

function snapshotEditState() {
  return JSON.stringify({
    walls, doors,
    furnitures: furnitures.map(f => ({ type: f.type, x: f.x, y: f.y, angle: f.angle })),
    boxes: boxes.map(b => ({ x: b.x, y: b.y })),
    extinguishers: extinguishers.map(e => ({ x: e.x, y: e.y })),
    fires: fires.map(f => ({ x: f.x, y: f.y, maxRadius: f.maxRadius })),
    initialFires,
    ropes: ropes.map(r => ({ x: r.x, y: r.y })),
    bandits: bandits.map(b => ({ x: b.x, y: b.y })),
    firefighters: firefighters.map(f => ({ x: f.x, y: f.y })),
    spawnPoint
  });
}

function restoreEditState(snapStr) {
  const s = JSON.parse(snapStr);
  walls = s.walls;
  doors = s.doors.map(d => Object.assign(new Door(d.hx, d.hy, d.length, d.baseAngle, d.type), d));
  furnitures = s.furnitures.map(f => new Furniture(f.type, f.x, f.y, f.angle));
  boxes = s.boxes.map(b => new WoodBox(b.x, b.y));
  extinguishers = s.extinguishers.map(e => new Extinguisher(e.x, e.y));
  fires = s.fires.map(f => new Fire(f.x, f.y, f.maxRadius));
  initialFires = s.initialFires;
  ropes = s.ropes.map(r => new Rope(r.x, r.y));
  bandits = s.bandits.map(b => new Bandit(b.x, b.y));
  firefighters = s.firefighters.map(f => new Firefighter(f.x, f.y));
  spawnPoint = s.spawnPoint;
  updateStats();
}

function pushUndo() {
  undoStack.push(snapshotEditState());
  if (undoStack.length > UNDO_LIMIT) undoStack.shift();
  redoStack = [];
}

function doUndo() {
  if (!isEditMode || undoStack.length === 0) return;
  redoStack.push(snapshotEditState());
  const snap = undoStack.pop();
  restoreEditState(snap);
}

function doRedo() {
  if (!isEditMode || redoStack.length === 0) return;
  undoStack.push(snapshotEditState());
  const snap = redoStack.pop();
  restoreEditState(snap);
}

// --- 部屋テンプレート (スタンプ) ---
let templates = {}; // name -> { items: [...] } (相対座標)
let templateCaptureStart = null;
let activeTemplateName = '';

function loadTemplatesFromStorage() {
  try {
    templates = JSON.parse(localStorage.getItem('fireGameTemplates') || '{}');
  } catch (e) { templates = {}; }
  refreshTemplateSelect();
}

function saveTemplatesToStorage() {
  localStorage.setItem('fireGameTemplates', JSON.stringify(templates));
}

function refreshTemplateSelect() {
  const sel = document.getElementById('sel-templates');
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">-- テンプレート一覧 --</option>';
  Object.keys(templates).forEach(name => {
    const opt = document.createElement('option');
    opt.value = name;
    opt.innerText = name;
    sel.appendChild(opt);
  });
  sel.value = current in templates ? current : '';
}

function selectTemplate(name) {
  activeTemplateName = name;
  const stampBtn = document.getElementById('btn-tool-template-stamp');
  if (stampBtn) stampBtn.disabled = !name;
}

function deleteSelectedTemplate() {
  if (!activeTemplateName || !templates[activeTemplateName]) return;
  delete templates[activeTemplateName];
  saveTemplatesToStorage();
  activeTemplateName = '';
  refreshTemplateSelect();
  selectTemplate('');
}

function captureTemplateFromRect(x1, y1, x2, y2) {
  const minX = Math.min(x1, x2), maxX = Math.max(x1, x2);
  const minY = Math.min(y1, y2), maxY = Math.max(y1, y2);
  const items = [];

  const inRect = (px, py) => px >= minX && px <= maxX && py >= minY && py <= maxY;

  walls.forEach(w => {
    if (inRect((w.x1 + w.x2) / 2, (w.y1 + w.y2) / 2)) {
      items.push({ kind: 'wall', x1: w.x1 - minX, y1: w.y1 - minY, x2: w.x2 - minX, y2: w.y2 - minY, type: w.type, hp: w.hp });
    }
  });
  doors.forEach(d => {
    if (inRect(d.hx, d.hy)) {
      items.push({ kind: 'door', x: d.hx - minX, y: d.hy - minY, length: d.length, angle: d.baseAngle, type: d.type });
    }
  });
  furnitures.forEach(f => {
    if (inRect(f.x, f.y)) items.push({ kind: 'furniture', type: f.type, x: f.x - minX, y: f.y - minY, angle: f.angle });
  });
  boxes.forEach(b => {
    if (inRect(b.x, b.y)) items.push({ kind: 'box', x: b.x - minX, y: b.y - minY });
  });
  extinguishers.forEach(ex => {
    if (inRect(ex.x, ex.y)) items.push({ kind: 'extinguisher', x: ex.x - minX, y: ex.y - minY });
  });

  if (items.length === 0) {
    alert('選択範囲内にオブジェクトがありません。');
    return;
  }
  const name = prompt('テンプレート名を入力してください:', '部屋テンプレート' + (Object.keys(templates).length + 1));
  if (!name) return;
  templates[name] = { items };
  saveTemplatesToStorage();
  refreshTemplateSelect();
  document.getElementById('sel-templates').value = name;
  selectTemplate(name);
}

function stampTemplateAt(name, ox, oy) {
  const tpl = templates[name];
  if (!tpl) return;
  pushUndo();
  tpl.items.forEach(it => {
    if (it.kind === 'wall') {
      walls.push({ x1: it.x1 + ox, y1: it.y1 + oy, x2: it.x2 + ox, y2: it.y2 + oy, type: it.type, hp: it.type === 'wood' ? 100 : undefined });
    } else if (it.kind === 'door') {
      doors.push(new Door(it.x + ox, it.y + oy, it.length, it.angle, it.type));
    } else if (it.kind === 'furniture') {
      furnitures.push(new Furniture(it.type, it.x + ox, it.y + oy, it.angle));
    } else if (it.kind === 'box') {
      boxes.push(new WoodBox(it.x + ox, it.y + oy));
    } else if (it.kind === 'extinguisher') {
      extinguishers.push(new Extinguisher(it.x + ox, it.y + oy));
    }
  });
  updateStats();
}

