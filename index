let furnitures = [
  new Furniture('desk', 60, 60, 0),
  new Furniture('chair', 60, 72, 0),
  new Furniture('bed', 40, 140, Math.PI / 2),
  new Furniture('shelf', 90, 30, 0),
  new Furniture('tv', 170, 40, Math.PI),
  new Furniture('phone', 60, 54, 0),
  new Furniture('washer', 200, 150, 0),
  new Furniture('clock', 120, 12, 0)
];
let boxes = [new WoodBox(40, 50)];
let extinguishers = [new Extinguisher(75, 90)];
let ropes = [new Rope(80, 50), new Rope(50, 130)];
let fires = [new Fire(170, 85)];
let initialFires = [{ x: 170, y: 85, maxRadius: 13.0 }]; // リセット時復元用バックアップ
let bandits = [new Bandit(180, 120), new Bandit(200, 50)];
let firefighters = [new Firefighter(50, 90)];

let foamParticles = [];
let ropeCutParticles = [];
let smokeParticles = [];

let carriedBox = null;
let carriedExtinguisher = null;
let carriedRope = null;

function updateStats() {
  document.getElementById('stat-walls').innerText = walls.length;
  document.getElementById('stat-doors').innerText = doors.length;
  document.getElementById('stat-furnitures').innerText = furnitures.length;
  document.getElementById('stat-boxes').innerText = boxes.length;
  document.getElementById('stat-exts').innerText = extinguishers.length;
  document.getElementById('stat-fires').innerText = fires.length;
  document.getElementById('stat-ropes').innerText = ropes.length;
  document.getElementById('stat-bandits').innerText = bandits.length;
  document.getElementById('stat-firefighters').innerText = firefighters.length;
}

// 火災ゲージ表示の更新
function updateFireGauge() {
  const fill = document.getElementById('fire-gauge-fill');
  const text = document.getElementById('fire-gauge-text');
  if (!fill || !text) return;

  const count = fires.length;
  if (!isClearMode) {
    fill.style.width = '100%';
    fill.style.background = '#00cc66';
    text.innerText = `${count} (フリーモード: 無制限)`;
  } else {
    const ratio = Math.min(100, (count / maxFireLimit) * 100);
    fill.style.width = `${ratio}%`;
    fill.style.background = ratio > 75 ? '#ff2200' : (ratio > 40 ? '#ffaa00' : '#ffff00');
    text.innerText = `${count} / ${maxFireLimit}`;
  }
}

// --- プレイヤー ---
class Player {
  constructor() {
    this.x = spawnPoint.x;
    this.y = spawnPoint.y;
    this.vx = 0;
    this.vy = 0;
    this.angle = 0;
    this.anim = new CharacterAnimation();

    this.rReachProgress = 0;
    this.lInteractProgress = 0;
  }

  update() {
    if (isGameOver || isGameClear) {
      this.vx = 0; this.vy = 0;
      return { speed: 0, isDashing: false, rReachProgress: 0, nodes: this.getNodesForGameOver() };
    }

    let inputX = (keys.d ? 1 : 0) - (keys.a ? 1 : 0);
    let inputY = (keys.s ? 1 : 0) - (keys.w ? 1 : 0);

    if (inputX !== 0 && inputY !== 0) {
      inputX *= 0.7071;
      inputY *= 0.7071;
    }

    const isDashing = keys.shift && (inputX !== 0 || inputY !== 0);
    const ACCEL = isDashing ? 0.36 : 0.18;
    const FRICTION = isDashing ? 0.80 : 0.74;

    this.vx = (this.vx + inputX * ACCEL) * FRICTION;
    this.vy = (this.vy + inputY * ACCEL) * FRICTION;

    if (carriedExtinguisher && keys.space) {
      this.vx -= Math.cos(this.angle) * 0.12;
      this.vy -= Math.sin(this.angle) * 0.12;
    }

    let nextX = this.x + this.vx;
    let nextY = this.y + this.vy;

    doors.forEach(d => d.update(nextX, nextY));

    const charRadius = 4.2;

    for (let iter = 0; iter < 3; iter++) {
      doors.forEach(d => {
        const dEnd = d.getEndPos();
        const col = collideCircleSegment(nextX, nextY, charRadius, d.hx, d.hy, dEnd.x, dEnd.y);
        nextX = col.x; nextY = col.y;
      });

      walls.forEach(w => {
        const col = collideCircleSegment(nextX, nextY, charRadius, w.x1, w.y1, w.x2, w.y2);
        nextX = col.x; nextY = col.y;
      });

      furnitures.forEach(f => {
        const col = collideCircleRotatedRect(nextX, nextY, charRadius, f.x, f.y, f.w, f.h, f.angle);
        nextX = col.x; nextY = col.y;
      });
    }

    this.x = Math.max(10, Math.min(WIDTH - 10, nextX));
    this.y = Math.max(10, Math.min(HEIGHT - 10, nextY));

    const speed = Math.hypot(this.vx, this.vy);

    if (speed > 0.05) {
      const targetAngle = Math.atan2(this.vy, this.vx);
      let diff = targetAngle - this.angle;
      while (diff < -Math.PI) diff += Math.PI * 2;
      while (diff > Math.PI) diff -= Math.PI * 2;
      this.angle += diff * (isDashing ? 0.32 : 0.22);
    }

    this.rReachProgress += isLightOn ? 0.15 : -0.15;
    this.rReachProgress = Math.max(0, Math.min(1, this.rReachProgress));

    const hasHeldItem = carriedBox || carriedExtinguisher || carriedRope || doors.some(d => d.isHeld) || keys.e;
    const targetLProgress = hasHeldItem ? 1.0 : 0.0;
    this.lInteractProgress += (targetLProgress - this.lInteractProgress) * 0.25;

    const animState = this.anim.update(this.x, this.y, this.angle, speed, isDashing);

    const cos = Math.cos(this.angle);
    const sin = Math.sin(this.angle);
    const sideCos = Math.cos(this.angle + Math.PI / 2);
    const sideSin = Math.sin(this.angle + Math.PI / 2);

    const headPos = { x: this.x + cos * 0.5, y: this.y + sin * 0.5 };
    const chestPos = { x: this.x + sideCos * animState.bodySway, y: this.y + sideSin * animState.bodySway };
    const pelvisPos = { x: this.x - cos * 2.0, y: this.y - sin * 2.0 };

    if (carriedBox) {
      let bX = chestPos.x + cos * 7.0 - sideCos * 0.5;
      let bY = chestPos.y + sin * 7.0 - sideSin * 0.5;
      carriedBox.x += (bX - carriedBox.x) * 0.45;
      carriedBox.y += (bY - carriedBox.y) * 0.45;
    }

    if (carriedExtinguisher) {
      let eX = chestPos.x + cos * 6.5 - sideCos * 0.5;
      let eY = chestPos.y + sin * 6.5 - sideSin * 0.5;
      carriedExtinguisher.x += (eX - carriedExtinguisher.x) * 0.5;
      carriedExtinguisher.y += (eY - carriedExtinguisher.y) * 0.5;

      if (keys.space && !isGameOver && !isGameClear) {
        const muzzleX = carriedExtinguisher.x + cos * 4;
        const muzzleY = carriedExtinguisher.y + sin * 4;
        for (let i = 0; i < 3; i++) {
          foamParticles.push(new FoamParticle(muzzleX, muzzleY, this.angle));
        }
      }
    }

    if (carriedRope) {
      let rX = chestPos.x + cos * 6.0;
      let rY = chestPos.y + sin * 6.0;
      carriedRope.x += (rX - carriedRope.x) * 0.5;
      carriedRope.y += (rY - carriedRope.y) * 0.5;
    }

    const defaultLHand = {
      x: chestPos.x - sideCos * 3.0 - cos * animState.armSwing * 0.6,
      y: chestPos.y - sideSin * 3.0 - sin * animState.armSwing * 0.6
    };

    let extendedLHand = {
      x: chestPos.x - sideCos * 1.5 + cos * 7.0,
      y: chestPos.y - sideSin * 1.5 + sin * 7.0
    };

    if (carriedBox) extendedLHand = { x: carriedBox.x, y: carriedBox.y };
    else if (carriedExtinguisher) extendedLHand = { x: carriedExtinguisher.x, y: carriedExtinguisher.y };
    else if (carriedRope) extendedLHand = { x: carriedRope.x, y: carriedRope.y };
    else {
      const heldDoor = doors.find(d => d.isHeld);
      if (heldDoor) extendedLHand = heldDoor.getKnobPos();
    }

    const lHand = {
      x: defaultLHand.x + (extendedLHand.x - defaultLHand.x) * this.lInteractProgress,
      y: defaultLHand.y + (extendedLHand.y - defaultLHand.y) * this.lInteractProgress
    };

    const rReachDist = 2 + this.rReachProgress * 6;
    const rSideDist = 3.0 - this.rReachProgress * 1.0;
    const rHandSwing = animState.armSwing * (1.0 - this.rReachProgress);

    const rHand = {
      x: chestPos.x + sideCos * rSideDist + cos * (rReachDist + rHandSwing),
      y: chestPos.y + sideSin * rSideDist + sin * (rReachDist + rHandSwing)
    };

    return {
      speed,
      isDashing,
      rReachProgress: this.rReachProgress,
      nodes: { head: headPos, chest: chestPos, pelvis: pelvisPos, lHand, rHand, lFoot: animState.lFoot, rFoot: animState.rFoot }
    };
  }

  getNodesForGameOver() {
    return {
      head: { x: this.x, y: this.y },
      chest: { x: this.x, y: this.y },
      pelvis: { x: this.x, y: this.y },
      lHand: { x: this.x - 2, y: this.y },
      rHand: { x: this.x + 2, y: this.y },
      lFoot: { x: this.x - 2, y: this.y + 3 },
      rFoot: { x: this.x + 2, y: this.y + 3 }
    };
  }
}

const player = new Player();
const playerParticles = [];
nodeDistribution.forEach(d => {
