// 2線分の交差判定（壁越しの延焼防止用）
function lineIntersectsSegment(x1, y1, x2, y2, x3, y3, x4, y4) {
  const denom = (y4 - y3) * (x2 - x1) - (x4 - x3) * (y2 - y1);
  if (denom === 0) return false;
  const ua = ((x4 - x3) * (y1 - y3) - (y4 - y3) * (x1 - x3)) / denom;
  const ub = ((x2 - x1) * (y1 - y3) - (y2 - y1) * (x1 - x3)) / denom;
  return ua >= 0 && ua <= 1 && ub >= 0 && ub <= 1;
}

// 壁を越えた延焼を判定（木壁は遮断しない）
function isPathBlockedByWall(x1, y1, x2, y2) {
  for (let w of walls) {
    if (w.type === 'wood') continue; // 木壁は遮断しない
    if (lineIntersectsSegment(x1, y1, x2, y2, w.x1, w.y1, w.x2, w.y2)) {
      return true;
    }
  }
  return false;
}

// --- 衝突計算 ---
function collideCircleSegment(px, py, radius, x1, y1, x2, y2) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const lenSq = dx * dx + dy * dy;
  let t = 0;
  if (lenSq > 0) {
    t = ((px - x1) * dx + (py - y1) * dy) / lenSq;
    t = Math.max(0, Math.min(1, t));
  }
  const nx = x1 + t * dx;
  const ny = y1 + t * dy;
  
  const diffX = px - nx;
  const diffY = py - ny;
  const distSq = diffX * diffX + diffY * diffY;

  if (distSq < radius * radius) {
    let dist = Math.sqrt(distSq);
    let pushX, pushY;

    if (dist < 0.0001) {
      const lineLen = Math.sqrt(lenSq) || 1;
      pushX = -dy / lineLen;
      pushY = dx / lineLen;
      dist = 0;
    } else {
      pushX = diffX / dist;
      pushY = diffY / dist;
    }

    const overlap = radius - dist;
    return { x: px + pushX * overlap, y: py + pushY * overlap, hit: true };
  }
  return { x: px, y: py, hit: false };
}

function collideCircleRect(px, py, radius, rx, ry, rw, rh) {
  const closestX = Math.max(rx - rw / 2, Math.min(px, rx + rw / 2));
  const closestY = Math.max(ry - rh / 2, Math.min(py, ry + rh / 2));
  const dx = px - closestX;
  const dy = py - closestY;
  const distSq = dx * dx + dy * dy;

  if (distSq < radius * radius) {
    const dist = Math.sqrt(distSq);
    if (dist < 0.0001) {
      return { x: px, y: py - radius, hit: true };
    }
    const overlap = radius - dist;
    return { x: px + (dx / dist) * overlap, y: py + (dy / dist) * overlap, hit: true };
  }
  return { x: px, y: py, hit: false };
}

function collideCircleRotatedRect(px, py, radius, rx, ry, rw, rh, angle) {
  if (!angle) return collideCircleRect(px, py, radius, rx, ry, rw, rh);

  const dx = px - rx;
  const dy = py - ry;
  const cos = Math.cos(-angle);
  const sin = Math.sin(-angle);
  const localX = dx * cos - dy * sin;
  const localY = dx * sin + dy * cos;

  const col = collideCircleRect(localX, localY, radius, 0, 0, rw, rh);
  if (!col.hit) return { x: px, y: py, hit: false };

  const unCos = Math.cos(angle);
  const unSin = Math.sin(angle);
  const worldX = rx + col.x * unCos - col.y * unSin;
  const worldY = ry + col.x * unSin + col.y * unCos;

  return { x: worldX, y: worldY, hit: true };
}

// --- 歩行アニメーションクラス ---
class CharacterAnimation {
  constructor() {
    this.walkPhase = 0;
    this.lFoot = { x: 0, y: 0 };
    this.rFoot = { x: 0, y: 0 };
  }

  update(px, py, angle, speed, isDashing) {
    const strideFreq = isDashing ? 0.35 : 0.22;
    if (speed > 0.08) {
      this.walkPhase += speed * strideFreq;
    } else {
      let diff = (Math.round(this.walkPhase / (Math.PI * 2)) * Math.PI * 2) - this.walkPhase;
      this.walkPhase += diff * 0.18;
    }

    const cos = Math.cos(angle);
    const sin = Math.sin(angle);
    const sideCos = Math.cos(angle + Math.PI / 2);
    const sideSin = Math.sin(angle + Math.PI / 2);

    const footSpacing = 1.8;
    const strideLength = isDashing ? 5.0 : 3.2;

    const lOffset = Math.sin(this.walkPhase) * strideLength;
    const rOffset = Math.sin(this.walkPhase + Math.PI) * strideLength;

    this.lFoot = {
      x: px - sideCos * footSpacing + cos * lOffset,
      y: py - sideSin * footSpacing + sin * lOffset
    };

    this.rFoot = {
      x: px + sideCos * footSpacing + cos * rOffset,
      y: py + sideSin * footSpacing + sin * rOffset
    };

    const bodyBob = Math.abs(Math.sin(this.walkPhase * 2)) * (speed > 0.1 ? 0.4 : 0.0);
    const bodySway = Math.sin(this.walkPhase) * (speed > 0.1 ? 0.2 : 0.0);

    return {
      lFoot: this.lFoot,
      rFoot: this.rFoot,
      bodyBob,
      bodySway,
      armSwing: Math.sin(this.walkPhase) * (isDashing ? 2.5 : 1.4)
    };
  }
}

// --- 構成粒子クラス ---
class CoreParticle {
  constructor(nodeName) {
    this.nodeName = nodeName;
    this.x = WIDTH / 2;
    this.y = HEIGHT / 2;
    this.vx = 0;
    this.vy = 0;

    if (nodeName === 'head') {
      this.radius = 1.4 + Math.random() * 0.6;
      this.offset = { x: (Math.random() - 0.5) * 1.8, y: (Math.random() - 0.5) * 1.8 };
    } else if (nodeName === 'chest') {
      this.radius = 1.3 + Math.random() * 0.6;
      this.offset = { x: (Math.random() - 0.5) * 1.0, y: (Math.random() - 0.5) * 2.6 };
    } else if (nodeName === 'pelvis') {
      this.radius = 1.1 + Math.random() * 0.5;
      this.offset = { x: (Math.random() - 0.5) * 1.0, y: (Math.random() - 0.5) * 1.8 };
    } else {
      this.radius = 1.0 + Math.random() * 0.4;
      this.offset = { x: (Math.random() - 0.5) * 0.8, y: (Math.random() - 0.5) * 0.8 };
    }
  }

  update(targetPos, bodyAngle, speed, isDashing) {
    const spread = isDashing ? 1.08 + speed * 0.05 : 1.0;
    const cos = Math.cos(bodyAngle);
    const sin = Math.sin(bodyAngle);

    const rx = (this.offset.x * cos - this.offset.y * sin) * spread;
    const ry = (this.offset.x * sin + this.offset.y * cos) * spread;

    const tx = targetPos.x + rx;
    const ty = targetPos.y + ry;

    const pull = 0.30;
    this.vx = (this.vx + (tx - this.x) * pull) * 0.55;
    this.vy = (this.vy + (ty - this.y) * pull) * 0.55;

    this.x += this.vx;
    this.y += this.vy;
  }
}

