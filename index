class Fire {
  constructor(x, y, maxRadius = 13.0) {
    this.x = x; this.y = y;
    this.maxHp = 100;
    this.hp = 25;
    this.radius = 3.0;
    this.maxRadius = maxRadius;
    this.spreadTimer = Math.random() * 200;
  }

  update() {
    // エディット中やゲーム終了時は火の活動を停止
    if (isEditMode || isGameOver || isGameClear) return;

    if (this.hp < this.maxHp) this.hp += 0.08;
    if (this.radius < this.maxRadius) this.radius += 0.006;

    // 木壁を燃やす処理
    walls.forEach(w => {
      if (w.type === 'wood') {
        const col = collideCircleSegment(this.x, this.y, 12, w.x1, w.y1, w.x2, w.y2);
        if (col.hit) {
          if (w.hp === undefined) w.hp = 100;
          w.hp -= 0.12;
        }
      }
    });

    // 風が強いほど延焼判定の間隔を早める（風下方向に燃え広がりやすくなる）
    // ※屋外の方が風の影響を強く受け、屋内は建物に遮られ弱まる
    const effWind = getEffectiveWindStrength();
    const windSpeedupFactor = 1 - Math.min(0.4, effWind * 0.03);

    if (this.hp > 75 && fires.length < 35) {
      this.spreadTimer++;
      if (this.spreadTimer > (450 + Math.random() * 300) * windSpeedupFactor) {
        this.spreadTimer = 0;
        let angle = Math.random() * Math.PI * 2;
        let dist = 9 + Math.random() * 12;

        if (effWind > 0) {
          // ランダム方向に風ベクトルを足し込んで、風下方向へ寄せる
          const windX = Math.cos(windAngle) * effWind * 0.12;
          const windY = Math.sin(windAngle) * effWind * 0.12;
          const rx = Math.cos(angle) + windX;
          const ry = Math.sin(angle) + windY;
          angle = Math.atan2(ry, rx);
          dist *= 1 + effWind * 0.05 * Math.max(0, Math.cos(angle - windAngle));
        }

        const nx = Math.max(10, Math.min(WIDTH - 10, this.x + Math.cos(angle) * dist));
        const ny = Math.max(10, Math.min(HEIGHT - 10, this.y + Math.sin(angle) * dist));

        // 壁を越えた延焼チェック（木壁以外は遮蔽される）
        if (!isPathBlockedByWall(this.x, this.y, nx, ny)) {
          fires.push(new Fire(nx, ny, Math.min(18, this.maxRadius + 1.5)));
          if (isEditMode) updateStats();
        }
      }
    }

    // 煙を発生させる（勢いのある炎ほど出やすい。風に流されて漂う）
    if (this.hp > 30 && smokeParticles.length < 260 && Math.random() < 0.05) {
      smokeParticles.push(new SmokeParticle(
        this.x + (Math.random() - 0.5) * this.radius,
        this.y + (Math.random() - 0.5) * this.radius
      ));
    }
  }
}

class Door {
  constructor(hx, hy, length = 22, baseAngle = Math.PI / 2, type = 'wood') {
    this.hx = hx; this.hy = hy;
    this.length = length;
    this.baseAngle = baseAngle;
    this.angle = baseAngle;
    this.isHeld = false;
    this.grabAngleOffset = 0;
    this.type = type || 'wood';
  }

  getKnobPos() {
    const kDist = this.length - 4;
    return { x: this.hx + Math.cos(this.angle) * kDist, y: this.hy + Math.sin(this.angle) * kDist };
  }

  getEndPos() {
    return { x: this.hx + Math.cos(this.angle) * this.length, y: this.hy + Math.sin(this.angle) * this.length };
  }

  startHold(playerX, playerY) {
    this.isHeld = true;
    const currentPlayerAngle = Math.atan2(playerY - this.hy, playerX - this.hx);
    this.grabAngleOffset = this.angle - currentPlayerAngle;
  }

  update(playerX, playerY) {
    if (this.isHeld) {
      const knob = this.getKnobPos();
      if (Math.hypot(playerX - knob.x, playerY - knob.y) > 25) {
        this.isHeld = false;
        return;
      }
      const currentPlayerAngle = Math.atan2(playerY - this.hy, playerX - this.hx);
      let targetA = currentPlayerAngle + this.grabAngleOffset;

      let diffFromBase = targetA - this.baseAngle;
      while (diffFromBase < -Math.PI) diffFromBase += Math.PI * 2;
      while (diffFromBase > Math.PI) diffFromBase -= Math.PI * 2;

      const maxLimit = Math.PI * 0.45;
      diffFromBase = Math.max(-maxLimit, Math.min(maxLimit, diffFromBase));
      targetA = this.baseAngle + diffFromBase;

      let diff = targetA - this.angle;
      while (diff < -Math.PI) diff += Math.PI * 2;
      while (diff > Math.PI) diff -= Math.PI * 2;

      diff = Math.max(-0.1, Math.min(0.1, diff * 0.3));
      this.angle += diff;
    }
  }
}

// 煙（炎から立ち上り、風向きに流されて漂う）
class SmokeParticle {
  constructor(x, y) {
    this.x = x; this.y = y;
    const ang = Math.random() * Math.PI * 2;
    const spd = 0.08 + Math.random() * 0.12;
    this.vx = Math.cos(ang) * spd;
    this.vy = Math.sin(ang) * spd;
    this.life = 1.0;
    this.decay = 0.0025 + Math.random() * 0.0018;
    this.radius = 2.5 + Math.random() * 3.5;
    this.growth = 0.008 + Math.random() * 0.01;
  }
  update() {
    const eff = getEffectiveWindStrength();
    if (eff > 0) {
      this.vx += Math.cos(windAngle) * eff * 0.006;
      this.vy += Math.sin(windAngle) * eff * 0.006;
    }
    this.vx *= 0.985;
    this.vy *= 0.985;
    this.x += this.vx;
    this.y += this.vy;
    this.radius += this.growth;
    this.life -= this.decay;
  }
}

class FoamParticle {
  constructor(x, y, angle, isFirefighter = false) {
    this.x = x; this.y = y;
    const speed = 2.2 + Math.random() * 1.8;
    const spread = (Math.random() - 0.5) * 0.45;
    this.vx = Math.cos(angle + spread) * speed;
    this.vy = Math.sin(angle + spread) * speed;
    this.life = 1.0;
    this.decay = 0.03 + Math.random() * 0.03;
    this.radius = 1.2 + Math.random() * 1.5;
    this.isFirefighter = isFirefighter; // 消防士NPCが発射した泡か（消火速度を遅くするため）
  }
  update() {
    this.x += this.vx; this.y += this.vy;
    this.vx *= 0.90; this.vy *= 0.90;
    this.life -= this.decay;
  }
}

class RopeCutParticle {
  constructor(x, y) {
    this.x = x; this.y = y;
    const a = Math.random() * Math.PI * 2;
    const spd = 0.8 + Math.random() * 1.5;
    this.vx = Math.cos(a) * spd;
    this.vy = Math.sin(a) * spd;
    this.life = 1.0;
  }
  update() {
    this.x += this.vx; this.y += this.vy;
    this.life -= 0.05;
  }
}

// 消防士 (味方NPC)
class Firefighter {
  constructor(x, y) {
    this.startX = x;
    this.startY = y;
    this.x = x;
    this.y = y;
    this.vx = 0;
    this.vy = 0;
    this.angle = Math.random() * Math.PI * 2;
    this.anim = new CharacterAnimation();
    this.particles = [];

    // 壁にハマった時の回避行動用
    this.stuckFrames = 0;
    this.avoidTimer = 0;
    this.avoidDir = 1;
    this.prevX = x;
    this.prevY = y;

    nodeDistribution.forEach(d => {
      for (let i = 0; i < d.count; i++) this.particles.push(new CoreParticle(d.name));
    });
  }

  reset() {
    this.x = this.startX;
    this.y = this.startY;
    this.vx = 0;
    this.vy = 0;
    this.angle = Math.random() * Math.PI * 2;
    this.stuckFrames = 0;
    this.avoidTimer = 0;
    this.prevX = this.startX;
    this.prevY = this.startY;
  }

  update() {
    if (isEditMode || isGameOver || isGameClear) return;

    // 仲間を助けようとしているバンディットがいれば最優先ターゲットにする
    let nearestBandit = null;
    let banditDist = 9999;
    bandits.forEach(b => {
      if (!b.isNeutralized && !b.isTied && b.rescuingTarget) {
        const d = Math.hypot(b.x - this.x, b.y - this.y);
        if (d < banditDist) {
          banditDist = d;
          nearestBandit = b;
        }
      }
    });

    // バンディットがいなければ一番近い火をターゲットにする
    let nearestFire = null;
    let minDist = 9999;
    fires.forEach(f => {
      const d = Math.hypot(f.x - this.x, f.y - this.y);
      if (d < minDist) {
        minDist = d;
        nearestFire = f;
      }
    });

    const target = nearestBandit ? nearestBandit : nearestFire;
    const targetDist = nearestBandit ? banditDist : minDist;

    // 前フレームの実移動量から「壁に引っかかっている」状態を検出する
    const actualMoved = Math.hypot(this.x - this.prevX, this.y - this.prevY);
    const triedToMove = Math.hypot(this.vx, this.vy);
    if (triedToMove > 0.12 && actualMoved < triedToMove * 0.25) {
      this.stuckFrames++;
    } else {
      this.stuckFrames = Math.max(0, this.stuckFrames - 2);
    }
    if (this.stuckFrames > 14 && this.avoidTimer <= 0) {
      // 壁沿いに迂回するため左右どちらかへ一定時間迂回する
      this.avoidTimer = 50 + Math.random() * 40;
      this.avoidDir = Math.random() < 0.5 ? 1 : -1;
      this.stuckFrames = 0;
    }
    if (this.avoidTimer > 0) this.avoidTimer--;

    if (target) {
      let targetAngle = Math.atan2(target.y - this.y, target.x - this.x);

      // 迂回中は目標角度を横方向にずらして壁沿いを回り込む
      if (this.avoidTimer > 0 && targetDist > 28) {
        targetAngle += this.avoidDir * (Math.PI * 0.55);
      }

      let diff = targetAngle - this.angle;
      while (diff < -Math.PI) diff += Math.PI * 2;
      while (diff > Math.PI) diff -= Math.PI * 2;
      this.angle += diff * 0.2;

      if (targetDist > 28) {
        // バンディットを追う時は少し素早く駆け寄る
        const chaseAccel = nearestBandit ? 0.28 : 0.2;
        this.vx = (this.vx + Math.cos(this.angle) * chaseAccel) * 0.78;
        this.vy = (this.vy + Math.sin(this.angle) * chaseAccel) * 0.78;
      } else {
        this.vx *= 0.5;
        this.vy *= 0.5;

        // 消火泡噴射（バンディットを狙っている時はそちらへ向けて噴射する）
        const muzzleX = this.x + Math.cos(this.angle) * 8;
        const muzzleY = this.y + Math.sin(this.angle) * 8;
        for (let i = 0; i < 2; i++) {
          foamParticles.push(new FoamParticle(muzzleX, muzzleY, this.angle, true));
        }
      }
    } else {
      this.vx *= 0.7;
      this.vy *= 0.7;
    }

    // 至近距離にいる場合は泡が届く前に即座に妨害する（保険としての近接判定）
    bandits.forEach(b => {
      if (!b.isNeutralized && !b.isTied && b.rescuingTarget) {
        if (Math.hypot(this.x - b.x, this.y - b.y) < 16) {
          b.hitByExtinguisher(this.x, this.y);
        }
      }
    });

    this.prevX = this.x;
    this.prevY = this.y;

    // 消防士もドアを自動で開けられるようにする（近づいたドアを押し開ける）
    doors.forEach(d => {
      if (d.isHeld) return;
      const dEnd = d.getEndPos();
      const midX = (d.hx + dEnd.x) / 2;
      const midY = (d.hy + dEnd.y) / 2;

      if (Math.hypot(this.x - midX, this.y - midY) < 22) {
        let pushDir = (Math.sin(this.angle - d.baseAngle) >= 0) ? 1 : -1;
        let targetAngle = d.baseAngle + pushDir * (Math.PI * 0.42);

        let diff = targetAngle - d.angle;
        while (diff < -Math.PI) diff += Math.PI * 2;
        while (diff > Math.PI) diff -= Math.PI * 2;

        d.angle += Math.max(-0.12, Math.min(0.12, diff * 0.25));
      }
    });

    let nextX = this.x + this.vx;
    let nextY = this.y + this.vy;
    const charR = 4.2;

    let pushSumX = 0, pushSumY = 0, pushCount = 0;
    walls.forEach(w => {
      const before = { x: nextX, y: nextY };
      const col = collideCircleSegment(nextX, nextY, charR, w.x1, w.y1, w.x2, w.y2);
      nextX = col.x; nextY = col.y;
      if (nextX !== before.x || nextY !== before.y) {
        pushSumX += nextX - before.x; pushSumY += nextY - before.y; pushCount++;
      }
    });
    doors.forEach(d => {
      const dEnd = d.getEndPos();
      const col = collideCircleSegment(nextX, nextY, charR, d.hx, d.hy, dEnd.x, dEnd.y);
      nextX = col.x; nextY = col.y;
    });
    furnitures.forEach(f => {
      const col = collideCircleRotatedRect(nextX, nextY, charR, f.x, f.y, f.w, f.h, f.angle);
      nextX = col.x; nextY = col.y;
    });

    this.x = Math.max(10, Math.min(WIDTH - 10, nextX));
    this.y = Math.max(10, Math.min(HEIGHT - 10, nextY));

    // 長時間スタックが解消しない場合の強制脱出（壁の角にハマって延々復帰しないのを防ぐ）
    if (this.stuckFrames > 90) {
      if (pushCount > 0) {
        this.x += (pushSumX / pushCount) * 3;
        this.y += (pushSumY / pushCount) * 3;
      }
      this.angle = Math.random() * Math.PI * 2;
      this.vx = 0; this.vy = 0;
      this.stuckFrames = 0;
      this.avoidTimer = 30 + Math.random() * 30;
      this.avoidDir = Math.random() < 0.5 ? 1 : -1;
    }
  }

  getNodes() {
    const spd = isEditMode || isGameOver || isGameClear ? 0 : Math.hypot(this.vx, this.vy);
    const animState = this.anim.update(this.x, this.y, this.angle, spd, false);

    const cos = Math.cos(this.angle);
    const sin = Math.sin(this.angle);
    const sideCos = Math.cos(this.angle + Math.PI / 2);
    const sideSin = Math.sin(this.angle + Math.PI / 2);

    const headPos = { x: this.x + cos * 0.5, y: this.y + sin * 0.5 };
    const chestPos = { x: this.x + sideCos * animState.bodySway, y: this.y + sideSin * animState.bodySway };
    const pelvisPos = { x: this.x - cos * 2.0, y: this.y - sin * 2.0 };

    const lHand = {
      x: chestPos.x - sideCos * 2.0 + cos * 5.0,
      y: chestPos.y - sideSin * 2.0 + sin * 5.0
    };
    const rHand = {
      x: chestPos.x + sideCos * 2.0 + cos * 6.0,
      y: chestPos.y + sideSin * 2.0 + sin * 6.0
    };

    return { head: headPos, chest: chestPos, pelvis: pelvisPos, lHand, rHand, lFoot: animState.lFoot, rFoot: animState.rFoot, spd };
  }
}

// 放火犯バンディット (NPC)
class Bandit {
  constructor(x, y) {
    this.startX = x;
    this.startY = y;
    this.x = x; this.y = y;
    this.vx = 0; this.vy = 0;
    this.angle = Math.random() * Math.PI * 2;
    this.anim = new CharacterAnimation();
    this.particles = [];

    nodeDistribution.forEach(d => {
      for (let i = 0; i < d.count; i++) this.particles.push(new CoreParticle(d.name));
    });

    this.isTied = false;
    this.isNeutralized = false;
    this.tiedTimer = 0;
    this.fireTimer = 180 + Math.random() * 180;
    this.targetX = x;
    this.targetY = y;

    // 連携・救出AI用変数
    this.rescuingTarget = null;
    this.rescueTimer = 0;

    // 消火器を吹きかけられた時の逃走＆救出抑制タイマー
    this.rescueCooldownTimer = 0; // 20秒(1200フレーム)
    this.fleeTimer = 0; // 走って逃げるタイマー
  }

  // 初期状態リセット
  reset() {
    this.x = this.startX;
    this.y = this.startY;
    this.vx = 0; this.vy = 0;
    this.angle = Math.random() * Math.PI * 2;
    this.isTied = false;
    this.isNeutralized = false;
    this.tiedTimer = 0;
    this.fireTimer = 180 + Math.random() * 180;
    this.targetX = this.startX;
    this.targetY = this.startY;
    this.rescuingTarget = null;
    this.rescueTimer = 0;
    this.rescueCooldownTimer = 0;
    this.fleeTimer = 0;
  }

  // 消火器噴射を受けた処理
  hitByExtinguisher(sourceX, sourceY) {
    if (this.isNeutralized || this.isTied) return;

    // 救出作業中断
    this.rescuingTarget = null;
    this.rescueTimer = 0;

    // 20秒間 (1200フレーム) 助けなくなる
    this.rescueCooldownTimer = 1200;

    // 走って逃げる方向を設定 (約3.5秒間逃走)
    this.fleeTimer = 210;
    const escapeAngle = Math.atan2(this.y - sourceY, this.x - sourceX) + (Math.random() - 0.5) * 0.8;
    this.targetX = Math.max(15, Math.min(WIDTH - 15, this.x + Math.cos(escapeAngle) * 90));
    this.targetY = Math.max(15, Math.min(HEIGHT - 15, this.y + Math.sin(escapeAngle) * 90));
  }

  update() {
    if (isEditMode || isGameOver || isGameClear) return;

    // タイマーデクリメント
    if (this.rescueCooldownTimer > 0) this.rescueCooldownTimer--;
    if (this.fleeTimer > 0) this.fleeTimer--;

    if (this.isNeutralized) {
      this.vx = 0; this.vy = 0;
      this.rescueTimer = 0;
      return;
    }

    if (this.isTied) {
      this.tiedTimer--;
      this.vx = 0; this.vy = 0;
      this.rescueTimer = 0;
      if (this.tiedTimer <= 0) {
        this.isTied = false;
        ropes.push(new Rope(this.x, this.y));
        if (isEditMode) updateStats();

        for (let i = 0; i < 12; i++) {
          ropeCutParticles.push(new RopeCutParticle(this.x, this.y));
        }
      }
      return;
    }

    // --- 仲間との連携救出AI ---
    // rescueCooldownTimerが0の時のみ仲間を助けるルーチンが機能する
    let trappedFriends = bandits.filter(b => b !== this && (b.isTied || b.isNeutralized));
    if (this.rescueCooldownTimer <= 0 && trappedFriends.length > 0) {
      // 一番近い捕まっている仲間を検索
      trappedFriends.sort((a, b) => Math.hypot(this.x - a.x, this.y - a.y) - Math.hypot(this.x - b.x, this.y - b.y));
      let targetFriend = trappedFriends[0];
      this.rescuingTarget = targetFriend;
      this.targetX = targetFriend.x;
      this.targetY = targetFriend.y;

      const distToFriend = Math.hypot(targetFriend.x - this.x, targetFriend.y - this.y);
      if (distToFriend < 14) {
        // 救出作業中 (5秒 = 300フレーム)
        this.rescueTimer++;
        this.vx *= 0.3;
        this.vy *= 0.3;
        this.angle = Math.atan2(targetFriend.y - this.y, targetFriend.x - this.x);

        if (this.rescueTimer >= 300) {
          // 開放（救出）成功！
          if (targetFriend.isNeutralized) {
            targetFriend.isNeutralized = false;
            boxes.push(new WoodBox(targetFriend.x, targetFriend.y)); // 箱をドロップ
          }
          if (targetFriend.isTied) {
            targetFriend.isTied = false;
            // 拘束解除時にも縄をドロップする
            ropes.push(new Rope(targetFriend.x, targetFriend.y));
            for (let i = 0; i < 12; i++) {
              ropeCutParticles.push(new RopeCutParticle(targetFriend.x, targetFriend.y));
            }
          }
          this.rescueTimer = 0;
          this.rescuingTarget = null;
          if (isEditMode) updateStats();
        }
      } else {
        this.rescueTimer = 0;
      }
    } else {
      this.rescuingTarget = null;
      this.rescueTimer = 0;

      const dist = Math.hypot(this.targetX - this.x, this.targetY - this.y);
      if (dist < 8 || Math.random() < (this.fleeTimer > 0 ? 0.08 : 0.015)) {
        this.targetX = Math.max(20, Math.min(WIDTH - 20, this.x + (Math.random() - 0.5) * (this.fleeTimer > 0 ? 120 : 90)));
        this.targetY = Math.max(20, Math.min(HEIGHT - 20, this.y + (Math.random() - 0.5) * (this.fleeTimer > 0 ? 120 : 90)));
      }
    }

    // 移動制御（逃走中は素早く移動）
    if (this.rescueTimer < 1) {
      const moveA = Math.atan2(this.targetY - this.y, this.targetX - this.x);
      const accel = this.fleeTimer > 0 ? 0.28 : 0.12;
      this.vx = (this.vx + Math.cos(moveA) * accel) * 0.78;
      this.vy = (this.vy + Math.sin(moveA) * accel) * 0.78;
    }

    let nextX = this.x + this.vx;
    let nextY = this.y + this.vy;

    if (Math.hypot(this.vx, this.vy) > 0.05) {
      this.angle = Math.atan2(this.vy, this.vx);
    }

    doors.forEach(d => {
      if (d.isHeld) return;
      const dEnd = d.getEndPos();
      const midX = (d.hx + dEnd.x) / 2;
      const midY = (d.hy + dEnd.y) / 2;
      
      if (Math.hypot(this.x - midX, this.y - midY) < 22) {
        let pushDir = (Math.sin(this.angle - d.baseAngle) >= 0) ? 1 : -1;
        let targetAngle = d.baseAngle + pushDir * (Math.PI * 0.42);

        let diff = targetAngle - d.angle;
        while (diff < -Math.PI) diff += Math.PI * 2;
        while (diff > Math.PI) diff -= Math.PI * 2;

        d.angle += Math.max(-0.12, Math.min(0.12, diff * 0.25));
      }
    });

    const charR = 4.2;
    walls.forEach(w => {
      const col = collideCircleSegment(nextX, nextY, charR, w.x1, w.y1, w.x2, w.y2);
      nextX = col.x; nextY = col.y;
    });
    doors.forEach(d => {
      const dEnd = d.getEndPos();
      const col = collideCircleSegment(nextX, nextY, charR, d.hx, d.hy, dEnd.x, dEnd.y);
      nextX = col.x; nextY = col.y;
    });
    furnitures.forEach(f => {
      const col = collideCircleRotatedRect(nextX, nextY, charR, f.x, f.y, f.w, f.h, f.angle);
      nextX = col.x; nextY = col.y;
    });

    this.x = Math.max(10, Math.min(WIDTH - 10, nextX));
    this.y = Math.max(10, Math.min(HEIGHT - 10, nextY));

    // 救出作業中でなければ放火（助けない20秒の最中も放火活動は継続する）
    if (!this.rescuingTarget) {
      this.fireTimer--;
      if (this.fireTimer <= 0) {
        this.fireTimer = 220 + Math.random() * 260;
        if (fires.length < 35) {
          fires.push(new Fire(this.x, this.y));
          if (isEditMode) updateStats();
        }
      }
    }
  }

  getNodes() {
    const spd = isEditMode || isGameOver || isGameClear ? 0 : Math.hypot(this.vx, this.vy);
    const animState = this.anim.update(this.x, this.y, this.angle, spd, this.fleeTimer > 0);

    const cos = Math.cos(this.angle);
    const sin = Math.sin(this.angle);
    const sideCos = Math.cos(this.angle + Math.PI / 2);
    const sideSin = Math.sin(this.angle + Math.PI / 2);

    const headPos = { x: this.x + cos * 0.5, y: this.y + sin * 0.5 };
    const chestPos = { x: this.x + sideCos * animState.bodySway, y: this.y + sideSin * animState.bodySway };
    const pelvisPos = { x: this.x - cos * 2.0, y: this.y - sin * 2.0 };

    const lHand = {
      x: chestPos.x - sideCos * 3.0 - cos * animState.armSwing * 0.6,
      y: chestPos.y - sideSin * 3.0 - sin * animState.armSwing * 0.6
    };
    const rHand = {
      x: chestPos.x + sideCos * 3.0 + cos * animState.armSwing * 0.6,
      y: chestPos.y + sideSin * 3.0 + sin * animState.armSwing * 0.6
    };

    return { head: headPos, chest: chestPos, pelvis: pelvisPos, lHand, rHand, lFoot: animState.lFoot, rFoot: animState.rFoot, spd };
  }
}

// --- 初期配置データ ---
let walls = [
  { x1: 120, y1: 0,   x2: 120, y2: 70, type: 'concrete' },
  { x1: 120, y1: 94,  x2: 120, y2: 180, type: 'wood', hp: 100 }
];
let initialWalls = walls.map(w => ({ ...w })); // リセット時復元用バックアップ（燃えて消えた木壁も復元する）
